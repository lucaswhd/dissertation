+        contexts=contexts,
+    )
+
+    got = common_anchor_mask(a, b, horizon=2)
+
+    # Rows 0/1 cross context 1->2; rows 3/4 and 8/9 run beyond their source.
+    # Prompt changes alone are allowed because B's gripper decisions define its
+    # subinstruction boundaries inside a single task context.
+    assert np.flatnonzero(got).tolist() == [2, 5, 6, 7]
+
+
+def test_common_anchor_mask_fails_on_misaligned_physical_rows() -> None:
+    a = _rows(prompts=["a"] * 4)
+    b = _rows(prompts=["b"] * 4)
+    b.action[1, 7] = 0.25
+
+    with pytest.raises(ValueError, match="action rows differ"):
+        common_anchor_mask(a, b, horizon=1)
+
+
+def test_source_balanced_sampling_is_deterministic_and_enforces_quotas() -> None:
+    rows = _rows(
+        prompts=["x"] * 12,
+        sources=[0] * 6 + [1] * 6,
+        frames=list(range(6)) * 2,
+        contexts=[1] * 12,
+    )
+    mask = np.ones(12, dtype=bool)
+
+    first = sample_source_balanced(rows, mask, context_id=1, per_source=3, seed=17)
+    second = sample_source_balanced(rows, mask, context_id=1, per_source=3, seed=17)
+
+    assert first.tolist() == second.tolist()
+    assert len(first) == 6
+    assert np.count_nonzero(rows.source_id[first] == 0) == 3
+    assert np.count_nonzero(rows.source_id[first] == 1) == 3
+
+
+def test_flow_noise_is_keyed_by_anchor_and_seed() -> None:
+    a = flow_noise(20260907, 3, 15, 1234, horizon=4, action_dim=5)
+    same = flow_noise(20260907, 3, 15, 1234, horizon=4, action_dim=5)
+    other_seed = flow_noise(20260907, 4, 15, 1234, horizon=4, action_dim=5)
+    other_anchor = flow_noise(20260907, 3, 15, 1235, horizon=4, action_dim=5)
+
+    assert a.shape == (4, 5)
+    assert a.dtype == np.float32
+    np.testing.assert_array_equal(a, same)
+    assert not np.array_equal(a, other_seed)
+    assert not np.array_equal(a, other_anchor)
+
+
+def test_null_chunk_holds_pose_and_grippers_but_zeros_base() -> None:
+    state = np.arange(ACTION_DIM, dtype=np.float32)
+    previous = np.full(ACTION_DIM, -9.0, dtype=np.float32)
+
+    got = null_chunk(state, previous, horizon=2)
+
+    np.testing.assert_array_equal(got[:, :3], np.zeros((2, 3), dtype=np.float32))
+    np.testing.assert_array_equal(got[:, 14], np.full(2, -9.0, dtype=np.float32))
+    np.testing.assert_array_equal(got[:, 22], np.full(2, -9.0, dtype=np.float32))
+    np.testing.assert_array_equal(got[:, 3:7], np.tile(state[3:7], (2, 1)))
+    np.testing.assert_array_equal(got[:, 7:14], np.tile(state[7:14], (2, 1)))
+    np.testing.assert_array_equal(got[:, 15:22], np.tile(state[15:22], (2, 1)))
+
+
+def test_gripper_event_matching_reports_tp_fp_and_f1() -> None:
+    predicted = np.zeros((4, ACTION_DIM), dtype=np.float32)
+    expert = np.zeros_like(predicted)
+    previous = np.zeros(ACTION_DIM, dtype=np.float32)
+    previous[[14, 22]] = -1.0
+    predicted[:, [14, 22]] = -1.0
+    expert[:, [14, 22]] = -1.0
+    expert[1:, 14] = 1.0
+    predicted[2:, 14] = 1.0
+    predicted[3:, 22] = 1.0
+
+    got = gripper_stats(predicted, expert, previous, tolerance=1)
+
+    assert got["expert_events"] == 1
+    assert got["predicted_events"] == 2
+    assert got["true_positives"] == 1
+    assert got["precision"] == pytest.approx(0.5)
+    assert got["recall"] == pytest.approx(1.0)
+    assert got["f1"] == pytest.approx(2.0 / 3.0)
+
+
+def test_gripper_f1_is_zero_when_expert_event_has_no_true_positive() -> None:
+    predicted = np.zeros((4, ACTION_DIM), dtype=np.float32)
+    expert = np.zeros_like(predicted)
+    previous = np.zeros(ACTION_DIM, dtype=np.float32)
+    previous[[14, 22]] = -1.0
+    predicted[:, [14, 22]] = -1.0
+    expert[:, [14, 22]] = -1.0
+    expert[1:, 14] = 1.0
+
+    got = gripper_stats(predicted, expert, previous, tolerance=0)
+
+    assert got["expert_events"] == 1
+    assert got["predicted_events"] == 0
+    assert got["true_positives"] == 0
+    assert got["precision"] is None
+    assert got["recall"] == 0.0
+    assert got["f1"] == 0.0
+
+
+def test_score_anchor_uses_null_skill_and_delta_motion() -> None:
+    state = np.zeros(ACTION_DIM, dtype=np.float32)
+    previous = np.zeros(ACTION_DIM, dtype=np.float32)
+    expert = np.zeros((2, ACTION_DIM), dtype=np.float32)
+    expert[:, 3:7] = 2.0
+    predicted = np.zeros_like(expert)
+    predicted[:, 3:7] = 1.0
+
+    got = score_anchor(predicted, expert, state, previous)
+
+    assert got["groups"]["arms"]["raw_mae"] == pytest.approx(4.0 / 18.0)
+    assert got["groups"]["arms"]["null_mae"] == pytest.approx(8.0 / 18.0)
+    assert got["groups"]["arms"]["skill"] == pytest.approx(0.5)
+    assert arm_motion_norm(predicted, state) == pytest.approx(4.0 / 18.0)
+    assert got["arm_motion_ratio"] == pytest.approx(0.5)
diff --git a/scripts/hrc/evaluate_hrc_pi05_continuous.py b/scripts/hrc/evaluate_hrc_pi05_continuous.py
--- /dev/null
+++ b/scripts/hrc/evaluate_hrc_pi05_continuous.py
@@ -0,0 +1,261 @@
+#!/usr/bin/env python
+"""Offline teacher-forced evaluation of the continuous π0.5 pilot checkpoint.
+
+Two modes (both feed RECORDED observations, so this is NOT closed-loop success):
+  metrics : per context, sample up to N valid anchors, run policy.infer on the
+            anchor observation and compare the predicted 32-step chunk to the
+            expert action rows -> per-group MAE (base / arms / grippers).
+  render  : for one val source, re-predict every ``--replan-every`` frames on the
+            recorded observations and write a head-RGB comparison video plus the
+            predicted/expert action arrays.
+
+Usage (openpi_hrc/.venv, needs GPU):
+  .venv/bin/python -m scripts.hrc.evaluate_hrc_pi05_continuous \
+      --config pi05_hrc_e5_continuous_main \
+      --checkpoint checkpoints/pi05_hrc_e5_continuous_main/hrc_e5_continuous_seed42/5000 \
+      --dataset-root /root/autodl-tmp/lerobot_datasets/hrc_pi05_continuous_clean_v0/val \
+      --mode metrics --max-anchors-per-context 300 --seed 42 \
+      --output-dir outputs/hrc_e5_continuous
+"""
+
+import argparse
+import glob
+import json
+from pathlib import Path
+
+import numpy as np
+
+ACTION_DIM = 23
+# 23-dim R1Pro physical action groups (base velocity, binary grippers, arm/torso).
+ACTION_GROUPS = {
+    "base": (0, 1, 2),
+    "left_gripper": (14,),
+    "right_gripper": (22,),
+    "arms": tuple(i for i in range(ACTION_DIM) if i not in {0, 1, 2, 14, 22}),
+}
+CONTEXT_NAMES = ("wait", "pickup", "follow", "radio")
+
+
+def action_group_mae(predicted: np.ndarray, expert: np.ndarray) -> dict[str, float]:
+    """Mean absolute error per action group over a [T, 23] chunk (or [23])."""
+
+    predicted = np.asarray(predicted, dtype=np.float32)
+    expert = np.asarray(expert, dtype=np.float32)
+    if predicted.shape != expert.shape or predicted.shape[-1] != ACTION_DIM:
+        raise ValueError(f"expected matching [...,23] chunks, got {predicted.shape} vs {expert.shape}")
+    return {
+        name: float(np.mean(np.abs(predicted[..., list(idx)] - expert[..., list(idx)])))
+        for name, idx in ACTION_GROUPS.items()
+    }
+
+
+def sample_anchors_per_context(
+    context_ids: np.ndarray,
+    valid_mask: np.ndarray,
+    *,
+    max_per_context: int,
+    seed: int,
+) -> dict[int, np.ndarray]:
+    """Per context, the valid anchor row indices, uniformly capped at N (seeded)."""
+
+    if max_per_context <= 0:
+        raise ValueError("max_per_context must be positive")
+    context_ids = np.asarray(context_ids, dtype=np.int64)
+    valid = np.asarray(valid_mask, dtype=bool)
+    rng = np.random.default_rng(seed)
+    sampled: dict[int, np.ndarray] = {}
+    for context in range(len(CONTEXT_NAMES)):
+        idx = np.flatnonzero((context_ids == context) & valid)
+        if len(idx) > max_per_context:
+            idx = np.sort(rng.choice(idx, size=max_per_context, replace=False))
+        sampled[context] = idx
+    return sampled
+
+
+def aggregate_group_mae(per_chunk: list[dict[str, float]]) -> dict[str, float]:
+    """Average per-group MAE across a list of per-chunk MAE dicts."""
+
+    if not per_chunk:
+        return {name: float("nan") for name in ACTION_GROUPS}
+    return {
+        name: float(np.mean([chunk[name] for chunk in per_chunk])) for name in ACTION_GROUPS
+    }
+
+
+# --------------------------------------------------------------------------- #
+# Everything below needs the dataset + GPU policy; kept out of the pure core.
+# --------------------------------------------------------------------------- #
+def _read_columns(split_root: Path):
+    import pyarrow as pa
+    import pyarrow.parquet as pq
+
+    files = sorted(glob.glob(str(split_root / "data" / "**" / "*.parquet"), recursive=True))
+    table = pa.concat_tables([pq.read_table(f) for f in files])
+    data = table.to_pydict()
+    order = np.argsort(np.asarray(data["index"], dtype=np.int64))
+    columns = {
+        "observation.state": np.asarray(data["observation.state"], dtype=np.float32)[order],
+        "action": np.asarray(data["action"], dtype=np.float32)[order],
+        "hrc.valid_anchor": np.asarray(data["hrc.valid_anchor"], dtype=bool)[order],
+        "hrc.context_id": np.asarray(data["hrc.context_id"], dtype=np.int64)[order],
+        "hrc.source_episode_id": np.asarray(data["hrc.source_episode_id"], dtype=np.int64)[order],
+        "hrc.fsm_state_id": np.asarray(data["hrc.fsm_state_id"], dtype=np.int64)[order],
+        "hrc.raw_global_frame_index": np.asarray(data["hrc.raw_global_frame_index"], dtype=np.int64)[order],
+        "episode_index": np.asarray(data["episode_index"], dtype=np.int64)[order],
+    }
+    tasks = pq.read_table(split_root / "meta" / "tasks.parquet").to_pydict()
+    index_to_task = {int(i): str(t) for i, t in zip(tasks["task_index"], tasks["task"], strict=True)}
+    prompts = np.array([index_to_task[int(ti)] for ti in np.asarray(data["task_index"])[order]], dtype=object)
+    return columns, prompts
+
+
+def _decode_source_frames(dataset_root: Path, source_id: int) -> np.ndarray:
+    """Decode one source's full head video into an [N, H, W, 3] uint8 array."""
+    import av
+
+    manifest = json.loads((dataset_root.parent / "manifest.json").read_text(encoding="utf-8"))
+    source = next(s for s in manifest["sources"] if int(s["source_episode_id"]) == source_id)
+    with av.open(str(source["head_video_path"])) as container:
+        frames = [frame.to_ndarray(format="rgb24") for frame in container.decode(container.streams.video[0])]
+    return np.asarray(frames, dtype=np.uint8)
+
+
+def _load_policy(config_name: str, checkpoint: Path):
+    from openpi.policies.policy_config import create_trained_policy
+    from openpi.training.config import get_config
+
+    return create_trained_policy(get_config(config_name), checkpoint)
+
+
+def _predict_chunk(policy, image: np.ndarray, state: np.ndarray, prompt: str) -> np.ndarray:
+    result = policy.infer(
+        {
+            "observation/image_0": np.asarray(image, dtype=np.uint8),
+            "observation/state": np.asarray(state, dtype=np.float32),
+            "prompt": str(prompt),
+        }
+    )
+    return np.asarray(result["actions"], dtype=np.float32)
+
+
+def run_metrics(args) -> int:
+    columns, prompts = _read_columns(args.dataset_root)
+    sampled = sample_anchors_per_context(
+        columns["hrc.context_id"], columns["hrc.valid_anchor"],
+        max_per_context=args.max_anchors_per_context, seed=args.seed,
+    )
+    policy = _load_policy(args.config, args.checkpoint)
+
+    # Decode each source's frames once and serve its sampled anchors from memory.
+    source_ids = sorted({int(s) for s in np.unique(columns["hrc.source_episode_id"])})
+    frames_by_source = {sid: _decode_source_frames(args.dataset_root, sid) for sid in source_ids}
+
+    per_context_chunks: dict[int, list[dict[str, float]]] = {c: [] for c in sampled}
+    for context, anchors in sampled.items():
+        for row in anchors:
+            source_id = int(columns["hrc.source_episode_id"][row])
+            frame_index = int(columns["hrc.raw_global_frame_index"][row])
+            image = frames_by_source[source_id][frame_index]
+            predicted = _predict_chunk(policy, image, columns["observation.state"][row], prompts[row])
+            expert = columns["action"][row : row + predicted.shape[0]]
+            per_context_chunks[context].append(action_group_mae(predicted[: len(expert)], expert))
+
+    report = {
+        "config": args.config,
+        "checkpoint": str(args.checkpoint),
+        "max_anchors_per_context": args.max_anchors_per_context,
+        "by_context": {
+            CONTEXT_NAMES[c]: {
+                "num_anchors": len(per_context_chunks[c]),
+                "group_mae": aggregate_group_mae(per_context_chunks[c]),
+            }
+            for c in sampled
+        },
+    }
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    (args.output_dir / "offline_metrics.json").write_text(
+        json.dumps(report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
+    )
+    print(json.dumps(report["by_context"], indent=2, ensure_ascii=False), flush=True)
+    return 0
+
+
+def run_render(args) -> int:
+    import av
+
+    from openpi.training.hrc_data import FSM_STATE_NAMES
+
+    columns, prompts = _read_columns(args.dataset_root)
+    rows = np.flatnonzero(columns["hrc.source_episode_id"] == args.source_id)
+    rows = rows[np.argsort(columns["hrc.raw_global_frame_index"][rows])]
+    frames = _decode_source_frames(args.dataset_root, args.source_id)
+    policy = _load_policy(args.config, args.checkpoint)
+
+    n = len(rows)
+    predicted_rows = np.zeros((n, ACTION_DIM), dtype=np.float32)
+    chunk = None
+    for local in range(n):
+        if local % args.replan_every == 0:
+            row = rows[local]
+            frame_index = int(columns["hrc.raw_global_frame_index"][row])
+            chunk = _predict_chunk(policy, frames[frame_index], columns["observation.state"][row], prompts[row])
+        predicted_rows[local] = chunk[min(local % args.replan_every, len(chunk) - 1)]
+
+    expert_rows = columns["action"][rows]
+    out = args.output_dir
+    out.mkdir(parents=True, exist_ok=True)
+    np.save(out / "anchor_indices.npy", rows)
+    np.save(out / "predicted_actions.npy", predicted_rows)
+    np.save(out / "expert_actions.npy", expert_rows)
+
+    cumulative = {name: [] for name in ACTION_GROUPS}
+    with av.open(str(out / "teacher_forced_comparison.mp4"), "w") as container:
+        stream = container.add_stream("libx264", rate=30)
+        stream.height, stream.width, stream.pix_fmt = frames.shape[1], frames.shape[2], "yuv420p"
+        for local in range(n):
+            mae = action_group_mae(predicted_rows[local], expert_rows[local])
+            for name in ACTION_GROUPS:
+                cumulative[name].append(mae[name])
+            frame = av.VideoFrame.from_ndarray(
+                np.ascontiguousarray(frames[int(columns["hrc.raw_global_frame_index"][rows[local]])]),
+                format="rgb24",
+            )
+            for packet in stream.encode(frame):
+                container.mux(packet)
+        for packet in stream.encode():
+            container.mux(packet)
+
+    metrics = {
+        "source_id": args.source_id,
+        "num_frames": n,
+        "replan_every": args.replan_every,
+        "group_mae": {name: float(np.mean(cumulative[name])) for name in ACTION_GROUPS},
+        "fsm_states_seen": sorted({FSM_STATE_NAMES[int(f)] for f in columns["hrc.fsm_state_id"][rows]}),
+    }
+    (out / "metrics.json").write_text(json.dumps(metrics, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+    print(json.dumps(metrics, indent=2, ensure_ascii=False), flush=True)
+    return 0
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", required=True)
+    parser.add_argument("--checkpoint", required=True, type=Path)
+    parser.add_argument("--dataset-root", required=True, type=Path)
+    parser.add_argument("--mode", choices=("metrics", "render"), required=True)
+    parser.add_argument("--max-anchors-per-context", type=int, default=300)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--source-id", type=int)
+    parser.add_argument("--replan-every", type=int, default=8)
+    parser.add_argument("--output-dir", required=True, type=Path)
+    args = parser.parse_args()
+
+    if args.mode == "metrics":
+        return run_metrics(args)
+    if args.source_id is None:
+        raise ValueError("--source-id is required for render mode")
+    return run_render(args)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/hrc/evaluate_hrc_pi05_continuous_test.py b/scripts/hrc/evaluate_hrc_pi05_continuous_test.py
--- /dev/null
+++ b/scripts/hrc/evaluate_hrc_pi05_continuous_test.py
@@ -0,0 +1,66 @@
+import numpy as np
+import pytest
+
+from scripts.hrc.evaluate_hrc_pi05_continuous import ACTION_GROUPS
+from scripts.hrc.evaluate_hrc_pi05_continuous import action_group_mae
+from scripts.hrc.evaluate_hrc_pi05_continuous import aggregate_group_mae
+from scripts.hrc.evaluate_hrc_pi05_continuous import sample_anchors_per_context
+
+
+def test_action_groups_partition_all_23_dims():
+    covered = sorted(i for idx in ACTION_GROUPS.values() for i in idx)
+    assert covered == list(range(23))
+
+
+def test_action_group_mae_zero_on_identical_and_isolates_groups():
+    predicted = np.zeros((32, 23), dtype=np.float32)
+    assert all(v == 0.0 for v in action_group_mae(predicted, predicted.copy()).values())
+
+    expert = predicted.copy()
+    expert[:, 14] = 2.0  # perturb only the left gripper dim
+    mae = action_group_mae(predicted, expert)
+    assert mae["left_gripper"] == pytest.approx(2.0)
+    assert mae["base"] == 0.0
+    assert mae["arms"] == 0.0
+    assert mae["right_gripper"] == 0.0
+
+
+def test_action_group_mae_rejects_shape_mismatch():
+    with pytest.raises(ValueError, match="23"):
+        action_group_mae(np.zeros((32, 22)), np.zeros((32, 22)))
+
+
+def test_sample_anchors_caps_per_context_and_is_seeded():
+    context = np.array([0] * 10 + [1] * 500 + [2] * 5 + [3] * 400, dtype=np.int64)
+    valid = np.ones(len(context), dtype=bool)
+    sampled = sample_anchors_per_context(context, valid, max_per_context=300, seed=42)
+
+    assert len(sampled[0]) == 10  # fewer than cap -> all kept
+    assert len(sampled[1]) == 300  # capped
+    assert len(sampled[2]) == 5
+    assert len(sampled[3]) == 300
+    # indices stay within their context and are sorted
+    assert np.all(context[sampled[1]] == 1)
+    assert np.array_equal(sampled[1], np.sort(sampled[1]))
+    # deterministic under the same seed
+    again = sample_anchors_per_context(context, valid, max_per_context=300, seed=42)
+    assert np.array_equal(sampled[1], again[1])
+
+
+def test_sample_anchors_respects_valid_mask():
+    context = np.zeros(100, dtype=np.int64)
+    valid = np.zeros(100, dtype=bool)
+    valid[[3, 7, 42]] = True
+    sampled = sample_anchors_per_context(context, valid, max_per_context=300, seed=0)
+    assert np.array_equal(sampled[0], [3, 7, 42])
+
+
+def test_aggregate_group_mae_averages_chunks():
+    chunks = [
+        {"base": 1.0, "arms": 2.0, "left_gripper": 0.0, "right_gripper": 0.0},
+        {"base": 3.0, "arms": 4.0, "left_gripper": 1.0, "right_gripper": 1.0},
+    ]
+    agg = aggregate_group_mae(chunks)
+    assert agg["base"] == pytest.approx(2.0)
+    assert agg["arms"] == pytest.approx(3.0)
+    assert np.isnan(aggregate_group_mae([])["base"])
diff --git a/scripts/hrc/export_hrc_continuous.py b/scripts/hrc/export_hrc_continuous.py
--- /dev/null
+++ b/scripts/hrc/export_hrc_continuous.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python
+"""Export the continuous CLEAN HRC dataset (one LeRobot episode per source).
+
+Usage (openpi_hrc/.venv):
+  .venv/bin/python scripts/hrc/export_hrc_continuous.py \
+      --data-root /root/autodl-tmp/hrc_pipeline_traintest/outputs/hrc_batch_final \
+      --qc-report /root/autodl-tmp/hrc_pipeline_traintest/outputs/hrc_batch_final/rescan_qc.json \
+      --base-manifest /root/autodl-tmp/lerobot_datasets/hrc_pi05_v0/manifest.json \
+      --output-root /root/autodl-tmp/lerobot_datasets/hrc_pi05_continuous_clean_v0 \
+      --manual-qc /root/autodl-tmp/lerobot_datasets/hrc_pi05_continuous_clean_v0_manual_qc.json \
+      --overwrite
+
+``--overwrite`` may only target the new continuous output; it must never point at
+the base ``hrc_pi05_v0`` (the exporter also refuses that by name).
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+from openpi.training.hrc_continuous_data import build_continuous_manifest
+from openpi.training.hrc_continuous_export import export_continuous_manifest
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--data-root", required=True, type=Path)
+    parser.add_argument("--qc-report", required=True, type=Path)
+    parser.add_argument("--base-manifest", required=True, type=Path)
+    parser.add_argument("--output-root", required=True, type=Path)
+    parser.add_argument("--manual-qc", type=Path, default=None,
+                        help="human video-review confirmation JSON for sources 25/36")
+    parser.add_argument("--action-horizon", type=int, default=32)
+    parser.add_argument("--overwrite", action="store_true")
+    parser.add_argument(
+        "--split-spec",
+        type=Path,
+        default=None,
+        help="frozen split spec JSON (expected_clean / manual_excluded / source_splits) for a "
+        "batch other than the v0 pilot; also usable as --base-manifest",
+    )
+    args = parser.parse_args()
+
+    overrides: dict = {}
+    if args.split_spec is not None:
+        spec = json.loads(args.split_spec.read_text(encoding="utf-8"))
+        overrides = {
+            "expected_clean": tuple(spec["expected_clean"]),
+            "manual_excluded": tuple(spec.get("manual_excluded", ())),
+            "schema_version": spec["dataset_version"],
+        }
+        print(
+            f"[export] split spec {args.split_spec.name}: "
+            f"clean={len(overrides['expected_clean'])} excluded={list(overrides['manual_excluded'])} "
+            f"version={overrides['schema_version']}",
+            flush=True,
+        )
+
+    print(f"[export] building continuous manifest from {args.data_root} ...", flush=True)
+    manifest = build_continuous_manifest(
+        args.data_root,
+        args.qc_report,
+        args.base_manifest,
+        action_horizon=args.action_horizon,
+        **overrides,
+    )
+    print(
+        f"[export] sources={manifest['num_sources']} splits="
+        f"{ {k: len(v) for k, v in manifest['source_splits'].items()} }",
+        flush=True,
+    )
+
+    report = export_continuous_manifest(
+        manifest, args.output_root, overwrite=args.overwrite, manual_qc_path=args.manual_qc
+    )
+    print("[export] done:", json.dumps(report["splits"], indent=2), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
