--- /dev/null
+++ b/scripts/hrc/build_rollout_subinstruction_schedule.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python
+"""Freeze the closed-loop sub-instruction schedule from the measured demo timings.
+
+Group B rewrote every Execute frame's prompt into one of 7 sub-goals, so replaying
+it with the old single long instruction would feed the policy a prompt that never
+appears on an Execute frame in its training set -- an out-of-distribution input whose
+result says nothing about the policy. The rollout therefore has to walk the same
+sub-goal sequence.
+
+Who advances the sequence is a design choice with consequences:
+
+  * timed schedule (this file) -- reproducible, uses no privileged state, and keeps
+    the high-level plan fixed so the measurement reads out low-level execution.
+  * geometric FSM on hand-object distance -- "smarter", but reads privileged object
+    poses the policy never sees and makes the switching logic a confounder.
+
+So the durations come from the 45 CLEAN demos: a segment ends at its median duration,
+or earlier if the policy's OWN gripper command produces the flip that segment ends
+with. ``min_frames`` is the 10th percentile of the measured distribution, so a policy
+that spams the gripper (the radio-round failure mode: precision 0.05) still cannot
+race through the schedule faster than the fastest real demonstration.
+
+Usage (openpi_hrc/.venv):
+  .venv/bin/python -m scripts.hrc.build_rollout_subinstruction_schedule \
+      --subinstructions /root/autodl-tmp/lerobot_datasets/hrc_subinstructions_rerun_v1.json \
+      --output /root/autodl-tmp/hrc_pipeline_traintest/configs/rollout_subinstruction_schedule.json
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def build_schedule(plan: dict, *, timeout_percentile: float, timeout_scale: float, min_percentile: float) -> dict:
+    sources = list(plan["sources"].values())
+    if not sources:
+        raise ValueError("sub-instruction plan contains no sources")
+
+    rounds: dict[str, list[dict]] = {}
+    for round_id in ("0", "1"):
+        segment_count = len(sources[0][round_id]["segments"])
+        if any(len(s[round_id]["segments"]) != segment_count for s in sources):
+            raise ValueError(f"round {round_id}: sources disagree on segment count")
+
+        segments = []
+        for index in range(segment_count):
+            durations, labels, ends = [], set(), set()
+            for source in sources:
+                segment = source[round_id]["segments"][index]
+                durations.append(segment["stop"] - segment["start"])
+                labels.add(segment["label"])
+                ends.add(segment["ends_with"])
+            if len(labels) != 1 or len(ends) != 1:
+                raise ValueError(f"round {round_id} segment {index}: inconsistent label/event")
+            samples = np.asarray(durations)
+            segments.append(
+                {
+                    "index": index,
+                    "label": labels.pop(),
+                    "ends_with": ends.pop(),
+                    "median_frames": int(np.median(samples)),
+                    "advance_frames": int(round(float(np.percentile(samples, timeout_percentile)) * timeout_scale)),
+                    "min_frames": int(np.percentile(samples, min_percentile)),
+                    "observed": {
+                        "n": len(samples),
+                        "p10": int(np.percentile(samples, 10)),
+                        "p90": int(np.percentile(samples, 90)),
+                        "max": int(samples.max()),
+                    },
+                }
+            )
+        rounds[round_id] = segments
+    return {
+        "source_plan": plan.get("manifest"),
+        "num_sources": len(sources),
+        "timeout_percentile": timeout_percentile,
+        "timeout_scale": timeout_scale,
+        "min_percentile": min_percentile,
+        "advance_rule": (
+            "advance when frames_in_segment >= advance_frames, or earlier when the "
+            "policy's own gripper command performs `ends_with` and "
+            "frames_in_segment >= min_frames"
+        ),
+        "rounds": rounds,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--subinstructions", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--timeout-percentile", type=float, default=90.0,
+                        help="percentile of measured durations used as the forced-advance timeout; "
+                             "advancing early truncates a reaching motion and corrupts the readout, "
+                             "while advancing late only costs budget, so this is deliberately generous")
+    parser.add_argument("--timeout-scale", type=float, default=1.0)
+    parser.add_argument("--min-percentile", type=float, default=10.0,
+                        help="percentile of measured durations used as the early-advance floor")
+    args = parser.parse_args()
+
+    plan = json.loads(args.subinstructions.read_text(encoding="utf-8"))
+    schedule = build_schedule(
+        plan,
+        timeout_percentile=args.timeout_percentile,
+        timeout_scale=args.timeout_scale,
+        min_percentile=args.min_percentile,
+    )
+    args.output.write_text(json.dumps(schedule, indent=2), encoding="utf-8")
+
+    for round_id, segments in schedule["rounds"].items():
+        total = sum(s["advance_frames"] for s in segments)
+        print(f"round {round_id}: {len(segments)} segments, {total} frames if never triggered early")
+        for segment in segments:
+            print(f"  {segment['index']:>2} advance@{segment['advance_frames']:>5} "
+                  f"min{segment['min_frames']:>5}  on={str(segment['ends_with']):<7} "
+                  f"{segment['label']}")
+    print(f"\nwrote {args.output}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/hrc/compute_hrc_norm_stats.py b/scripts/hrc/compute_hrc_norm_stats.py
--- /dev/null
+++ b/scripts/hrc/compute_hrc_norm_stats.py
@@ -0,0 +1,105 @@
+"""Compute train-only HRC mean/std without decoding RGB videos."""
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from openpi.shared import normalize
+from openpi.training import config as _config
+from openpi.training import hrc_norm_stats
+from openpi.training import lerobot_compat
+
+DELTA_MAPPINGS = (
+    (tuple(range(3, 7)), tuple(range(3, 7))),
+    (tuple(range(7, 14)), tuple(range(7, 14))),
+    (tuple(range(15, 22)), tuple(range(15, 22))),
+)
+
+
+def _load_numpy_columns(dataset_root: Path, repo_id: str, state_key: str) -> dict[str, np.ndarray]:
+    dataset = lerobot_compat.LeRobotDataset(repo_id=repo_id, root=dataset_root)
+    table = dataset.hf_dataset.with_format("numpy")
+    keys = (state_key, "action", "hrc.valid_anchor", "hrc.task_id", "hrc.source_episode_id", "episode_index")
+    return {key: np.asarray(table[key]) for key in keys}
+
+
+def _validate_train_only(factory: _config.LeRobotHrcDataConfig, columns: dict[str, np.ndarray]) -> None:
+    if factory.split != "train":
+        raise ValueError("HRC normalization statistics may only be computed from split='train'")
+    manifest_path = Path(factory.manifest_path)
+    manifest = json.loads(manifest_path.read_text())
+    train_sources = {int(value) for value in manifest["source_splits"]["train"]}
+    val_test_sources = {
+        int(value) for split in ("val", "test") for value in manifest["source_splits"][split]
+    }
+    observed_sources = {int(value) for value in np.unique(columns["hrc.source_episode_id"])}
+    if not observed_sources or not observed_sources.issubset(train_sources):
+        raise ValueError("dataset contains sources outside the manifest train split")
+    if observed_sources & val_test_sources:
+        raise ValueError("validation/test source leakage detected in normalization data")
+
+
+def main(config_name: str, *, overwrite: bool = False) -> None:
+    train_config = _config.get_config(config_name)
+    factory = train_config.data
+    if not isinstance(factory, _config.LeRobotHrcDataConfig):
+        raise TypeError(f"config {config_name!r} is not an HRC LeRobot config")
+
+    dataset_root = Path(factory.dataset_root)
+    columns = _load_numpy_columns(dataset_root, str(factory.repo_id), factory.state_key)
+    _validate_train_only(factory, columns)
+
+    valid_indices = np.flatnonzero(columns["hrc.valid_anchor"])
+    horizon = train_config.model.action_horizon
+    episode_ids = columns["episode_index"]
+    if np.any(episode_ids[valid_indices] != episode_ids[valid_indices + horizon - 1]):
+        raise ValueError("valid HRC action chunks cross an episode boundary")
+
+    stats = hrc_norm_stats.compute_hrc_norm_stats_from_arrays(
+        states=columns[factory.state_key],
+        actions=columns["action"],
+        valid_mask=columns["hrc.valid_anchor"],
+        task_ids=columns["hrc.task_id"],
+        action_horizon=horizon,
+        delta_mappings=DELTA_MAPPINGS,
+        task_weights=factory.task_weights,
+    )
+
+    asset_id = factory.assets.asset_id
+    assets_dir = factory.assets.assets_dir
+    if not asset_id or not assets_dir:
+        raise ValueError("HRC config must define an explicit norm stats assets_dir and asset_id")
+    output_dir = Path(assets_dir) / asset_id
+    output_path = output_dir / "norm_stats.json"
+    if output_path.exists() and not overwrite:
+        raise FileExistsError(f"refusing to overwrite {output_path}; pass --overwrite")
+    normalize.save(output_dir, stats)
+
+    valid_task_ids = columns["hrc.task_id"][valid_indices]
+    # Support 4 continuous context ids while keeping the legacy 3-task output shape.
+    counts = np.bincount(valid_task_ids, minlength=max(3, int(valid_task_ids.max()) + 1))
+    print(
+        json.dumps(
+            {
+                "config": config_name,
+                "dataset_root": str(dataset_root),
+                "num_valid_anchors": len(valid_indices),
+                "valid_anchors_by_task": counts.tolist(),
+                "task_weights": factory.task_weights,
+                "state_dim": int(columns[factory.state_key].shape[-1]),
+                "action_dim": int(columns["action"].shape[-1]),
+                "output": str(output_path),
+            },
+            indent=2,
+        )
+    )
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--config-name", required=True)
+    parser.add_argument("--overwrite", action="store_true")
+    args = parser.parse_args()
+    main(args.config_name, overwrite=args.overwrite)
diff --git a/scripts/hrc/compute_target_visibility.py b/scripts/hrc/compute_target_visibility.py
--- /dev/null
+++ b/scripts/hrc/compute_target_visibility.py
@@ -0,0 +1,179 @@
+#!/usr/bin/env python
+"""Per-frame geometric visibility of each task object in the head camera.
+
+Measured on the 45 CLEAN episodes: during the pickup Execute phase the target is
+outside the head camera's field of view about 25% of the time, and in ~70% of
+episodes it is not visible at all on the first frame -- the robot has to travel for
+5-9 seconds before the can or trash can first enters the image. A training anchor
+taken from such a frame asks the policy to reach for something it cannot see, so the
+correct action is not recoverable from the observation and the sample is unlearnable
+rather than merely hard.
+
+This writes the per-frame mask so training can be restricted to well-posed frames,
+and so the "target visible" fraction can be reported as a dataset property.
+
+The camera convention is not assumed: it is calibrated against the recorded
+``human_visible`` flag, which the collector produced independently. Only conventions
+reproducing that flag are used, and the achieved agreement is written to the report
+so a silent frame-convention change cannot corrupt the mask unnoticed.
+
+Usage (openpi_hrc/.venv):
+  .venv/bin/python -m scripts.hrc.compute_target_visibility \
+      --batch-root /root/autodl-tmp/hrc_pipeline_traintest/outputs/hrc_batch_rerun_v1 \
+      --output /root/autodl-tmp/lerobot_datasets/hrc_target_visibility_rerun_v1.json
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+# Head camera intrinsics recorded in every episode_meta.json.
+HFOV_DEG = 105.8538533653792
+VFOV_DEG = 87.81459492868048
+# Height above the human's recorded foot position used when calibrating against the
+# recorded visibility flag; the collector's flag tracks the body, not the floor point.
+HUMAN_BODY_OFFSET_M = 1.0
+
+
+def quat_to_rotation(quat: np.ndarray) -> np.ndarray:
+    """Rotation matrix from an (x, y, z, w) quaternion."""
+    x, y, z, w = quat
+    return np.array(
+        [
+            [1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
+            [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
+            [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)],
+        ]
+    )
+
+
+def in_view(cam_pos: np.ndarray, cam_quat: np.ndarray, target: np.ndarray) -> bool:
+    """True when the target lies inside the camera frustum (camera looks along -Z)."""
+    local = quat_to_rotation(cam_quat).T @ (target - cam_pos)
+    forward = -local[2]
+    if forward <= 0:
+        return False
+    horizontal = np.degrees(np.arctan2(abs(local[0]), forward))
+    vertical = np.degrees(np.arctan2(abs(local[1]), forward))
+    return bool(horizontal < HFOV_DEG / 2 and vertical < VFOV_DEG / 2)
+
+
+def calibration_agreement(episode: dict, stride: int = 37) -> float:
+    """Agreement between the geometric test and the collector's own visibility flag."""
+    cam_pos = episode["head_camera_world_pos"]
+    cam_quat = episode["head_camera_world_quat"]
+    human = episode["human_pos"].copy()
+    human[:, 2] += HUMAN_BODY_OFFSET_M
+    flag = episode["human_visible_flag"].astype(bool)
+    checks = [
+        in_view(cam_pos[t], cam_quat[t], human[t]) == flag[t]
+        for t in range(0, len(cam_pos), stride)
+    ]
+    return float(np.mean(checks)) if checks else float("nan")
+
+
+def episode_visibility(episode: dict, object_names: list[str]) -> dict:
+    cam_pos = episode["head_camera_world_pos"]
+    cam_quat = episode["head_camera_world_quat"]
+    objects = episode["object_pos"]
+    masks = {}
+    for index, name in enumerate(object_names):
+        masks[name] = np.array(
+            [in_view(cam_pos[t], cam_quat[t], objects[t, index]) for t in range(len(cam_pos))],
+            dtype=bool,
+        )
+    return masks
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--batch-root", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--min-agreement", type=float, default=0.85,
+                        help="reject the run if the geometry disagrees with the recorded flag")
+    args = parser.parse_args()
+
+    manifest = json.loads((args.batch_root / "batch_manifest.json").read_text(encoding="utf-8"))
+    clean = [int(e["idx"]) for e in manifest["episodes"] if e["verdict"] == "CLEAN"]
+
+    report = {
+        "batch_root": str(args.batch_root),
+        "hfov_deg": HFOV_DEG,
+        "vfov_deg": VFOV_DEG,
+        "camera_forward_axis": "-Z",
+        "quaternion_order": "xyzw",
+        "sources": {},
+    }
+    agreements = []
+    any_visible_execute = []
+    per_object_execute = {}
+
+    for source_id in clean:
+        data = np.load(args.batch_root / f"ep_{source_id:04d}/data/trajectories.npz", allow_pickle=True)
+        meta = json.loads(
+            (args.batch_root / f"ep_{source_id:04d}/meta/episode_meta.json").read_text(encoding="utf-8")
+        )
+        episode = {key: data[key] for key in
+                   ("head_camera_world_pos", "head_camera_world_quat", "human_pos",
+                    "human_visible_flag", "object_pos", "fsm_state_id", "round_id")}
+        object_names = [str(n) for n in data["object_names"]]
+
+        agreement = calibration_agreement(episode)
+        agreements.append(agreement)
+        masks = episode_visibility(episode, object_names)
+
+        execute = (episode["fsm_state_id"] == meta["fsm_states"].index("ExecuteBehaviorTask")) & (
+            episode["round_id"] == 0
+        )
+        cans = [n for n in object_names if n.startswith("can_of_soda")]
+        any_can = np.any([masks[n] for n in cans], axis=0)
+        any_visible_execute.append(float(any_can[execute].mean()))
+        for name in object_names:
+            per_object_execute.setdefault(name, []).append(float(masks[name][execute].mean()))
+
+        report["sources"][str(source_id)] = {
+            "num_frames": int(len(episode["fsm_state_id"])),
+            "flag_agreement": agreement,
+            "execute_round0_frames": int(execute.sum()),
+            "visible_fraction_execute": {n: float(masks[n][execute].mean()) for n in object_names},
+            "any_can_visible_fraction_execute": float(any_can[execute].mean()),
+            "visible_runs": {
+                n: [[int(a), int(b)] for a, b in _runs(masks[n])] for n in object_names
+            },
+        }
+
+    worst = float(np.min(agreements))
+    report["calibration"] = {
+        "mean_flag_agreement": float(np.mean(agreements)),
+        "min_flag_agreement": worst,
+        "min_required": args.min_agreement,
+    }
+    if worst < args.min_agreement:
+        raise SystemExit(
+            f"camera geometry only reproduces the recorded visibility flag at {worst:.1%} "
+            f"(need {args.min_agreement:.0%}); refusing to emit a mask that may be wrong"
+        )
+
+    args.output.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(f"{len(clean)} episodes; flag agreement mean {np.mean(agreements):.1%} "
+          f"min {worst:.1%}")
+    print(f"\nround0 Execute 段内目标可见帧占比：")
+    for name, values in per_object_execute.items():
+        print(f"  {name:<18} 中位 {np.median(values):.1%}  最低 {np.min(values):.1%}")
+    print(f"  {'任意一个罐子可见':<18} 中位 {np.median(any_visible_execute):.1%}  "
+          f"最低 {np.min(any_visible_execute):.1%}")
+    print(f"\nwrote {args.output}")
+    return 0
+
+
+def _runs(mask: np.ndarray):
+    """Contiguous [start, stop) spans where the mask is True."""
+    padded = np.concatenate([[False], mask, [False]])
+    edges = np.flatnonzero(padded[1:] != padded[:-1])
+    return list(zip(edges[::2], edges[1::2], strict=True))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/hrc/dissertation_protocol.py b/scripts/hrc/dissertation_protocol.py
--- /dev/null
+++ b/scripts/hrc/dissertation_protocol.py
@@ -0,0 +1,556 @@
+#!/usr/bin/env python
+"""Pure, shared protocol utilities for the frozen dissertation experiments."""
+
+from __future__ import annotations
+
+import csv
+import dataclasses
+import glob
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+ACTION_DIM = 23
+MODEL_ACTION_DIM = 32
+ACTION_HORIZON = 32
+CONTEXT_NAMES = ("wait", "pickup", "follow", "radio")
+BASE_DIMS = (0, 1, 2)
+GRIPPER_DIMS = (14, 22)
+DELTA_DIMS = tuple(i for i in range(ACTION_DIM) if i not in {*BASE_DIMS, *GRIPPER_DIMS})
+ACTION_GROUPS = {
+    "arms": DELTA_DIMS,
+    "base": BASE_DIMS,
+    "grippers": GRIPPER_DIMS,
+}
+
+
+@dataclasses.dataclass(frozen=True)
+class SplitRows:
+    """Physical rows from one LeRobot split, ordered by the exported global index."""
+
+    split_root: Path
+    dataset_version: str
+    state: np.ndarray
+    action: np.ndarray
+    valid: np.ndarray
+    context_id: np.ndarray
+    source_id: np.ndarray
+    fsm_state_id: np.ndarray
+    raw_frame: np.ndarray
+    episode_index: np.ndarray
+    task_index: np.ndarray
+    prompts: np.ndarray
+    task_id: np.ndarray | None = None
+
+    def __len__(self) -> int:
+        return len(self.action)
+
+
+def load_split_rows(split_root: Path) -> SplitRows:
+    """Load the columns needed by every dissertation experiment."""
+    import pyarrow as pa
+    import pyarrow.parquet as pq
+
+    split_root = Path(split_root).resolve()
+    files = sorted(glob.glob(str(split_root / "data" / "**" / "*.parquet"), recursive=True))
+    if not files:
+        raise FileNotFoundError(f"no parquet data below {split_root}")
+    table = pa.concat_tables([pq.read_table(path) for path in files])
+    data = table.to_pydict()
+    required = {
+        "observation.state",
+        "action",
+        "hrc.valid_anchor",
+        "hrc.task_id",
+        "hrc.context_id",
+        "hrc.source_episode_id",
+        "hrc.fsm_state_id",
+        "hrc.raw_global_frame_index",
+        "episode_index",
+        "task_index",
+        "index",
+    }
+    missing = sorted(required - data.keys())
+    if missing:
+        raise ValueError(f"{split_root} is missing required columns: {missing}")
+
+    order = np.argsort(np.asarray(data["index"], dtype=np.int64))
+    tasks_path = split_root / "meta" / "tasks.parquet"
+    if not tasks_path.is_file():
+        raise FileNotFoundError(tasks_path)
+    tasks = pq.read_table(tasks_path).to_pydict()
+    index_to_task = {
+        int(index): str(task)
+        for index, task in zip(tasks["task_index"], tasks["task"], strict=True)
+    }
+    task_index = np.asarray(data["task_index"], dtype=np.int64)[order]
+    try:
+        prompts = np.asarray([index_to_task[int(index)] for index in task_index], dtype=object)
+    except KeyError as exc:
+        raise ValueError(f"task index {exc.args[0]} has no prompt in {tasks_path}") from exc
+
+    rows = SplitRows(
+        split_root=split_root,
+        dataset_version=split_root.parent.name,
+        state=np.asarray(data["observation.state"], dtype=np.float32)[order],
+        action=np.asarray(data["action"], dtype=np.float32)[order],
+        valid=np.asarray(data["hrc.valid_anchor"], dtype=bool)[order],
+        task_id=np.asarray(data["hrc.task_id"], dtype=np.int64)[order],
+        context_id=np.asarray(data["hrc.context_id"], dtype=np.int64)[order],
+        source_id=np.asarray(data["hrc.source_episode_id"], dtype=np.int64)[order],
+        fsm_state_id=np.asarray(data["hrc.fsm_state_id"], dtype=np.int64)[order],
+        raw_frame=np.asarray(data["hrc.raw_global_frame_index"], dtype=np.int64)[order],
+        episode_index=np.asarray(data["episode_index"], dtype=np.int64)[order],
+        task_index=task_index,
+        prompts=prompts,
+    )
+    _validate_split_rows(rows)
+    return rows
+
+
+def _validate_split_rows(rows: SplitRows) -> None:
+    lengths = {
+        len(rows.state),
+        len(rows.action),
+        len(rows.valid),
+        len(rows.context_id),
+        len(rows.source_id),
+        len(rows.fsm_state_id),
+        len(rows.raw_frame),
+        len(rows.episode_index),
+        len(rows.task_index),
+        len(rows.prompts),
+    }
+    if rows.task_id is not None:
+        lengths.add(len(rows.task_id))
+    if len(lengths) != 1:
+        raise ValueError(f"split columns have inconsistent lengths: {sorted(lengths)}")
+    if rows.state.shape != (len(rows), ACTION_DIM) or rows.action.shape != (len(rows), ACTION_DIM):
+        raise ValueError(
+            f"expected state/action [N,{ACTION_DIM}], got {rows.state.shape}/{rows.action.shape}"
+        )
+    if not np.isfinite(rows.state).all() or not np.isfinite(rows.action).all():
+        raise ValueError(f"non-finite state/action values in {rows.split_root}")
+    if np.any((rows.context_id < 0) | (rows.context_id >= len(CONTEXT_NAMES))):
+        raise ValueError(f"invalid context id in {rows.split_root}")
+
+
+def context_stable_mask(rows: SplitRows, *, horizon: int = ACTION_HORIZON) -> np.ndarray:
+    """Mask rows whose future stays within one source, episode, and task context."""
+    if horizon <= 0:
+        raise ValueError("horizon must be positive")
+    stable = np.zeros(len(rows), dtype=bool)
+    for row in np.flatnonzero(rows.valid):
+        stop = int(row) + horizon
+        if stop >= len(rows):
+            continue
+        if rows.source_id[stop] != rows.source_id[row]:
+            continue
+        if rows.episode_index[stop] != rows.episode_index[row]:
+            continue
+        if rows.raw_frame[stop] - rows.raw_frame[row] != horizon:
+            continue
+        window = slice(int(row), stop + 1)
+        stable[row] = bool(np.all(rows.context_id[window] == rows.context_id[row]))
+    return stable
+
+
+def prompt_stable_mask(rows: SplitRows, *, horizon: int = ACTION_HORIZON) -> np.ndarray:
+    """Mask rows whose inclusive [anchor, anchor+horizon] window stays semantically fixed."""
+    stable = context_stable_mask(rows, horizon=horizon)
+    for row in np.flatnonzero(stable):
+        stop = int(row) + horizon
+        stable[row] = bool(np.all(rows.prompts[int(row) : stop + 1] == rows.prompts[row]))
+    return stable
+
+
+def common_anchor_mask(a: SplitRows, b: SplitRows, *, horizon: int = ACTION_HORIZON) -> np.ndarray:
+    """Validate physical row equality and return the strict A/B common-anchor mask."""
+    if len(a) != len(b):
+        raise ValueError(f"row count differs: {len(a)} != {len(b)}")
+    for name in ("source_id", "raw_frame", "context_id", "fsm_state_id", "episode_index"):
+        if not np.array_equal(getattr(a, name), getattr(b, name)):
+            raise ValueError(f"{name} rows differ between datasets")
+    if not np.array_equal(a.state, b.state):
+        raise ValueError("state rows differ between datasets")
+    if not np.array_equal(a.action, b.action):
+        raise ValueError("action rows differ between datasets")
+    return a.valid & b.valid & context_stable_mask(a, horizon=horizon) & context_stable_mask(b, horizon=horizon)
+
+
+def sample_source_balanced(
+    rows: SplitRows,
+    mask: np.ndarray,
+    *,
+    context_id: int,
+    per_source: int,
+    seed: int,
+    allow_exhausted: bool = False,
+) -> np.ndarray:
+    """Choose an equal seeded quota per source, or all rows when exhaustion is allowed."""
+    if per_source <= 0:
+        raise ValueError("per_source must be positive")
+    mask = np.asarray(mask, dtype=bool)
+    if mask.shape != (len(rows),):
+        raise ValueError(f"mask must have shape {(len(rows),)}, got {mask.shape}")
+    selected: list[np.ndarray] = []
+    sources = sorted(int(source) for source in np.unique(rows.source_id[mask]))
+    if not sources:
+        raise ValueError(f"no candidates for context {context_id}")
+    for source in sources:
+        candidates = np.flatnonzero(mask & (rows.context_id == context_id) & (rows.source_id == source))
+        if len(candidates) < per_source and not allow_exhausted:
+            raise ValueError(
+                f"source {source} context {context_id} has {len(candidates)} candidates, need {per_source}"
+            )
+        if len(candidates) <= per_source:
+            chosen = candidates
+        else:
+            rng = np.random.default_rng(np.random.SeedSequence([seed, context_id, source]))
+            chosen = np.sort(rng.choice(candidates, size=per_source, replace=False))
+        selected.append(chosen)
+    return np.sort(np.concatenate(selected)).astype(np.int64)
+
+
+def semantic_label(prompt: str) -> str:
+    value = str(prompt)
+    value = value.removeprefix("Task: ")
+    marker = " Phase: "
+    if marker in value:
+        value = value.split(marker, maxsplit=1)[0]
+    return value.rstrip(".")
+
+
+def build_common_audit_manifest(
+    a: SplitRows,
+    b: SplitRows,
+    *,
+    protocol_seed: int,
+    per_source: int,
+    horizon: int = ACTION_HORIZON,
+) -> dict[str, Any]:
+    common = common_anchor_mask(a, b, horizon=horizon)
+    anchors: list[dict[str, Any]] = []
+    candidate_counts: dict[str, int] = {}
+    selected_counts: dict[str, int] = {}
+    for context_id, context in enumerate(CONTEXT_NAMES):
+        candidate_counts[context] = int(np.count_nonzero(common & (a.context_id == context_id)))
+        chosen = sample_source_balanced(
+            a,
+            common,
+            context_id=context_id,
+            per_source=per_source,
+            seed=protocol_seed,
+            allow_exhausted=context == "wait",
+        )
+        selected_counts[context] = len(chosen)
+        for chosen_row in chosen:
+            row = int(chosen_row)
+            anchors.append(
+                {
+                    "anchor_id": f"s{int(a.source_id[row]):04d}_f{int(a.raw_frame[row]):06d}",
+                    "source_episode_id": int(a.source_id[row]),
+                    "raw_global_frame_index": int(a.raw_frame[row]),
+                    "row_a": row,
+                    "row_bc": row,
+                    "context": context,
+                    "context_id": context_id,
+                    "fsm_state_id": int(a.fsm_state_id[row]),
+                    "prompt_a": str(a.prompts[row]),
+                    "prompt_bc": str(b.prompts[row]),
+                    "semantic_label": semantic_label(str(b.prompts[row])),
+                    "split": "val",
+                    "valid_status": {
+                        "a_export_valid": bool(a.valid[row]),
+                        "bc_export_valid": bool(b.valid[row]),
+                        "a_context_stable_through_horizon": True,
+                        "bc_context_stable_through_horizon": True,
+                        "prompt_change_within_horizon_allowed": True,
+                        "common": True,
+                    },
+                }
+            )
+    anchors.sort(key=lambda item: (item["context_id"], item["source_episode_id"], item["raw_global_frame_index"]))
+    return {
+        "schema_version": 1,
+        "protocol": "source-balanced strict common validation anchors",
+        "protocol_seed": int(protocol_seed),
+        "action_horizon": int(horizon),
+        "flow_noise_shape": [int(horizon), MODEL_ACTION_DIM],
+        "dataset_versions": {"A": a.dataset_version, "B_C": b.dataset_version},
+        "dataset_roots": {"A": str(a.split_root), "B_C": str(b.split_root)},
+        "candidate_counts": candidate_counts,
+        "selected_counts": selected_counts,
+        "source_ids": sorted({int(item["source_episode_id"]) for item in anchors}),
+        "num_anchors": len(anchors),
+        "anchors": anchors,
+    }
+
+
+def flow_noise(
+    protocol_seed: int,
+    flow_seed: int,
+    source_id: int,
+    frame_index: int,
+    *,
+    horizon: int = ACTION_HORIZON,
+    action_dim: int = MODEL_ACTION_DIM,
+) -> np.ndarray:
+    """Standard-normal flow noise keyed solely by the frozen protocol and anchor."""
+    values = (protocol_seed, flow_seed, source_id, frame_index, horizon, action_dim)
+    if any(int(value) < 0 for value in values):
+        raise ValueError(f"noise key values must be non-negative, got {values}")
+    seed = np.random.SeedSequence([int(value) for value in values])
+    return np.random.default_rng(seed).standard_normal((horizon, action_dim)).astype(np.float32)
+
+
+def _validate_chunk(chunk: np.ndarray, *, name: str) -> np.ndarray:
+    value = np.asarray(chunk, dtype=np.float32)
+    if value.ndim != 2 or value.shape[1] != ACTION_DIM:
+        raise ValueError(f"{name} must have shape [T,{ACTION_DIM}], got {value.shape}")
+    if not np.isfinite(value).all():
+        raise ValueError(f"{name} contains non-finite values")
+    return value
+
+
+def null_chunk(state: np.ndarray, previous_action: np.ndarray, horizon: int) -> np.ndarray:
+    """Physical no-op: zero base, held grippers, and zero delta on arms/torso."""
+    state = np.asarray(state, dtype=np.float32)
+    previous_action = np.asarray(previous_action, dtype=np.float32)
+    if state.shape != (ACTION_DIM,) or previous_action.shape != (ACTION_DIM,):
+        raise ValueError(f"state and previous_action must both be [{ACTION_DIM}]")
+    if horizon <= 0:
+        raise ValueError("horizon must be positive")
+    row = np.zeros(ACTION_DIM, dtype=np.float32)
+    row[list(DELTA_DIMS)] = state[list(DELTA_DIMS)]
+    row[list(GRIPPER_DIMS)] = previous_action[list(GRIPPER_DIMS)]
+    return np.repeat(row[None, :], horizon, axis=0)
+
+
+def group_mae(predicted: np.ndarray, expert: np.ndarray) -> dict[str, float]:
+    predicted = _validate_chunk(predicted, name="predicted")
+    expert = _validate_chunk(expert, name="expert")
+    if predicted.shape != expert.shape:
+        raise ValueError(f"predicted/expert shape mismatch: {predicted.shape} != {expert.shape}")
+    return {
+        group: float(np.mean(np.abs(predicted[:, list(dims)] - expert[:, list(dims)])))
+        for group, dims in ACTION_GROUPS.items()
+    }
+
+
+def arm_motion_norm(chunk: np.ndarray, state: np.ndarray) -> float:
+    chunk = _validate_chunk(chunk, name="chunk")
+    state = np.asarray(state, dtype=np.float32)
+    if state.shape != (ACTION_DIM,):
+        raise ValueError(f"state must have shape [{ACTION_DIM}], got {state.shape}")
+    return float(np.mean(np.abs(chunk[:, list(DELTA_DIMS)] - state[list(DELTA_DIMS)])))
+
+
+def _flip_events(sign_rows: np.ndarray, previous_sign: np.ndarray) -> list[tuple[int, int, float]]:
+    previous = np.vstack([previous_sign[None, :], sign_rows[:-1]])
+    return [
+        (int(frame), int(gripper), float(sign_rows[frame, gripper]))
+        for frame, gripper in np.argwhere(sign_rows != previous)
+    ]
+
+
+def gripper_stats(
+    predicted: np.ndarray,
+    expert: np.ndarray,
+    previous_action: np.ndarray,
+    *,
+    tolerance: int = 8,
+) -> dict[str, float | int | None]:
+    predicted = _validate_chunk(predicted, name="predicted")
+    expert = _validate_chunk(expert, name="expert")
+    if predicted.shape != expert.shape:
+        raise ValueError(f"predicted/expert shape mismatch: {predicted.shape} != {expert.shape}")
+    if tolerance < 0:
+        raise ValueError("tolerance must be non-negative")
+    previous = np.asarray(previous_action, dtype=np.float32)
+    if previous.shape != (ACTION_DIM,):
+        raise ValueError(f"previous_action must have shape [{ACTION_DIM}]")
+    pred_sign = np.sign(predicted[:, list(GRIPPER_DIMS)])
+    expert_sign = np.sign(expert[:, list(GRIPPER_DIMS)])
+    previous_sign = np.sign(previous[list(GRIPPER_DIMS)])
+    expert_events = _flip_events(expert_sign, previous_sign)
+    predicted_events = _flip_events(pred_sign, previous_sign)
+    unmatched = list(expert_events)
+    true_positives = 0
+    for frame, gripper, sign in predicted_events:
+        for index, (expert_frame, expert_gripper, expert_sign_value) in enumerate(unmatched):
+            if (
+                gripper == expert_gripper
+                and sign == expert_sign_value
+                and abs(frame - expert_frame) <= tolerance
+            ):
+                true_positives += 1
+                unmatched.pop(index)
+                break
+    precision = true_positives / len(predicted_events) if predicted_events else None
+    recall = true_positives / len(expert_events) if expert_events else None
+    f1 = 2 * true_positives / (len(predicted_events) + len(expert_events)) if expert_events else None
+    return {
+        "sign_accuracy": float(np.mean(pred_sign == expert_sign)),
+        "expert_events": len(expert_events),
+        "predicted_events": len(predicted_events),
+        "true_positives": true_positives,
+        "precision": precision,
+        "recall": recall,
+        "f1": f1,
+        "tolerance_frames": tolerance,
+    }
+
+
+def score_anchor(
+    predicted: np.ndarray,
+    expert: np.ndarray,
+    state: np.ndarray,
+    previous_action: np.ndarray,
+    *,
+    gripper_tolerance: int = 8,
+) -> dict[str, Any]:
+    predicted = _validate_chunk(predicted, name="predicted")
+    expert = _validate_chunk(expert, name="expert")
+    null = null_chunk(state, previous_action, len(expert))
+    raw = group_mae(predicted, expert)
+    null_mae = group_mae(null, expert)
+    groups = {
+        group: {
+            "raw_mae": raw[group],
+            "null_mae": null_mae[group],
+            "skill": 1.0 - raw[group] / null_mae[group] if null_mae[group] > 0 else None,
+        }
+        for group in ACTION_GROUPS
+    }
+    predicted_motion = arm_motion_norm(predicted, state)
+    expert_motion = arm_motion_norm(expert, state)
+    return {
+        "groups": groups,
+        "arm_motion_model": predicted_motion,
+        "arm_motion_expert": expert_motion,
+        "arm_motion_ratio": predicted_motion / expert_motion if expert_motion > 0 else None,
+        "gripper": gripper_stats(
+            predicted,
+            expert,
+            previous_action,
+            tolerance=gripper_tolerance,
+        ),
+    }
+
+
+def aggregate_anchor_records(records: list[dict[str, Any]]) -> dict[str, Any]:
+    """Aggregate anchor scores, pooling sparse gripper event counts."""
+    if not records:
+        raise ValueError("cannot aggregate an empty record list")
+    groups: dict[str, dict[str, float | None]] = {}
+    for group in ACTION_GROUPS:
+        raw = float(np.mean([record["groups"][group]["raw_mae"] for record in records]))
+        null = float(np.mean([record["groups"][group]["null_mae"] for record in records]))
+        groups[group] = {
+            "raw_mae": raw,
+            "null_mae": null,
+            "skill": 1.0 - raw / null if null > 0 else None,
+        }
+    model_motion = float(np.mean([record["arm_motion_model"] for record in records]))
+    expert_motion = float(np.mean([record["arm_motion_expert"] for record in records]))
+    expert_events = int(sum(record["gripper"]["expert_events"] for record in records))
+    predicted_events = int(sum(record["gripper"]["predicted_events"] for record in records))
+    true_positives = int(sum(record["gripper"]["true_positives"] for record in records))
+    precision = true_positives / predicted_events if predicted_events else None
+    recall = true_positives / expert_events if expert_events else None
+    f1 = 2 * true_positives / (predicted_events + expert_events) if expert_events else None
+    return {
+        "num_anchors": len(records),
+        "groups": groups,
+        "arm_motion_model": model_motion,
+        "arm_motion_expert": expert_motion,
+        "arm_motion_ratio": model_motion / expert_motion if expert_motion > 0 else None,
+        "gripper": {
+            "sign_accuracy": float(np.mean([record["gripper"]["sign_accuracy"] for record in records])),
+            "expert_events": expert_events,
+            "predicted_events": predicted_events,
+            "true_positives": true_positives,
+            "precision": precision,
+            "recall": recall,
+            "f1": f1,
+            "tolerance_frames": int(records[0]["gripper"]["tolerance_frames"]),
+        },
+    }
+
+
+def bootstrap_summary(
+    values: np.ndarray | list[float],
+    *,
+    seed: int,
+    num_resamples: int = 10_000,
+) -> dict[str, float | int | None]:
+    """Deterministic scalar summary with a percentile bootstrap CI for the mean."""
+    array = np.asarray(values, dtype=np.float64)
+    array = array[np.isfinite(array)]
+    if not len(array):
+        return {"mean": None, "median": None, "std": None, "ci95_low": None, "ci95_high": None, "n": 0}
+    std = float(np.std(array, ddof=1)) if len(array) > 1 else 0.0
+    if len(array) == 1 or num_resamples <= 0:
+        low = high = float(array[0])
+    else:
+        rng = np.random.default_rng(seed)
+        means = np.empty(num_resamples, dtype=np.float64)
+        batch = 1_000
+        for start in range(0, num_resamples, batch):
+            size = min(batch, num_resamples - start)
+            sample = rng.choice(array, size=(size, len(array)), replace=True)
+            means[start : start + size] = sample.mean(axis=1)
+        low, high = (float(value) for value in np.quantile(means, [0.025, 0.975]))
+    return {
+        "mean": float(np.mean(array)),
+        "median": float(np.median(array)),
+        "std": std,
+        "ci95_low": low,
+        "ci95_high": high,
+        "n": len(array),
+    }
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _reject_nonfinite_json(value: Any) -> None:
+    if isinstance(value, float) and not np.isfinite(value):
+        raise ValueError(f"refusing to write non-finite JSON value {value}")
+    if isinstance(value, dict):
+        for item in value.values():
+            _reject_nonfinite_json(item)
+    elif isinstance(value, list | tuple):
+        for item in value:
+            _reject_nonfinite_json(item)
+
+
+def write_json_atomic(path: Path, value: Any) -> None:
+    _reject_nonfinite_json(value)
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def write_csv_atomic(path: Path, rows: list[dict[str, Any]], fieldnames: list[str]) -> None:
+    if not rows:
+        raise ValueError(f"refusing to write empty CSV {path}")
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    with temporary.open("w", encoding="utf-8", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fieldnames, extrasaction="raise")
+        writer.writeheader()
+        writer.writerows(rows)
+    temporary.replace(path)
