diff --git a/scripts/hrc/serve_hrc_pi05_rollout.py b/scripts/hrc/serve_hrc_pi05_rollout.py
--- /dev/null
+++ b/scripts/hrc/serve_hrc_pi05_rollout.py
@@ -0,0 +1,257 @@
+#!/usr/bin/env python
+"""pi0.5 HRC policy inference server for closed-loop rollout.
+
+Speaks the SAME length-prefixed pickle TCP protocol as the pipeline's
+`scripts/evaluation/act_policy_server.py`, so the existing behavior-venv rollout
+client can drive our openpi pi0.5 policy with minimal changes. Runs inside the
+openpi_hrc `.venv`; the OmniGibson sim runs in behavior-venv; they talk over
+localhost TCP (cross-venv, numpy-version-agnostic wire codec copied verbatim).
+
+Protocol (superset of the ACT server):
+  {"type":"ping"}   -> {"ok":True,"msg":"pong","action_horizon":32,
+                        "action_dim":23,"execute_horizon":H}
+  {"type":"reset"}  -> {"ok":True}   # episode boundary: drop the cached plan
+  {"type":"act", "state": f32[23], "head": u8[H,W,3],
+   "prompt": str | ("task": str [, "phase": str])} -> {"ok":True,"action": f32[23]}
+  {"type":"shutdown"} -> {"ok":True}
+
+Chunking (handoff §22): each `act` returns ONE 23-dim action. The server keeps a
+queue of the first `execute_horizon` (default 8) steps of the last 32-step
+prediction; when the queue drains it re-runs policy.infer on the CURRENT obs
+(= predict 32, execute first 8, re-observe). `reset` clears the queue.
+
+Usage (openpi_hrc/.venv):
+  XLA_PYTHON_CLIENT_PREALLOCATE=false \
+  python scripts/hrc/serve_hrc_pi05_rollout.py \
+      --config pi05_hrc_e4_main \
+      --checkpoint /root/autodl-tmp/openpi_hrc/checkpoints/pi05_hrc_e4_main/hrc_e4_seed42/5000
+"""
+
+import argparse
+import collections
+import pickle
+import socket
+import struct
+import time
+import traceback
+from pathlib import Path
+
+import numpy as np
+
+
+ACTION_HORIZON = 32
+ACTION_DIM = 23
+EXECUTE_HORIZON = 8
+
+
+def canonical_checkpoint_path(value: Path | str) -> Path:
+    """Return one stable checkpoint identity for logs and run-plan matching."""
+
+    return Path(value).expanduser().resolve()
+
+
+def validate_execute_horizon(value: int) -> int:
+    """Steps executed per 32-step plan.
+
+    The frozen HRC protocol is 8 (see HANDOFF 17.2); anything else is a
+    deliberate replan-rate experiment, so it is allowed but announced. The
+    client re-checks this value in its handshake, so both ends must agree and
+    a run can never silently mix rates.
+    """
+    execute_horizon = int(value)
+    if not 1 <= execute_horizon <= ACTION_HORIZON:
+        raise ValueError(
+            f"execute_horizon must be within [1, {ACTION_HORIZON}], got {execute_horizon}"
+        )
+    if execute_horizon != EXECUTE_HORIZON:
+        print(
+            f"[pi05-server] WARNING: execute_horizon={execute_horizon} deviates from the "
+            f"frozen HRC protocol ({EXECUTE_HORIZON}); label these runs as a replan-rate "
+            f"experiment and do not pool them with protocol-compliant results.",
+            flush=True,
+        )
+    return execute_horizon
+
+
+def validate_act_request(message: dict) -> tuple[np.ndarray, np.ndarray]:
+    state = np.asarray(message.get("state"), dtype=np.float32)
+    if state.shape != (ACTION_DIM,):
+        raise ValueError(f"expected state shape (23,), got {state.shape}")
+    if not np.isfinite(state).all():
+        raise ValueError("state must be finite")
+
+    head = np.asarray(message.get("head"))
+    if head.ndim != 3 or head.shape[-1] != 3:
+        raise ValueError(f"expected HWC RGB head image, got {head.shape}")
+    if not np.isfinite(head).all():
+        raise ValueError("head image must be finite")
+    if np.issubdtype(head.dtype, np.floating):
+        scale = 255.0 if head.size and float(head.max()) <= 1.0 else 1.0
+        head = np.clip(head * scale, 0.0, 255.0).astype(np.uint8)
+    else:
+        head = np.clip(head, 0, 255).astype(np.uint8)
+    return state, head
+
+
+def validate_action_chunk(value) -> np.ndarray:
+    actions = np.asarray(value, dtype=np.float32)
+    if actions.shape != (ACTION_HORIZON, ACTION_DIM):
+        raise ValueError(f"expected actions shape [32, 23], got {actions.shape}")
+    if not np.isfinite(actions).all():
+        raise ValueError("policy action chunk must be finite")
+    return actions
+
+# --- numpy-version-agnostic wire codec (copied verbatim from act_policy_server) --
+def _pack(obj):
+    if isinstance(obj, np.ndarray):
+        arr = np.ascontiguousarray(obj)
+        return {"__nd__": True, "data": arr.tobytes(), "dtype": str(arr.dtype), "shape": list(arr.shape)}
+    if isinstance(obj, np.generic):
+        return obj.item()
+    if isinstance(obj, dict):
+        return {k: _pack(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return [_pack(v) for v in obj]
+    return obj
+
+
+def _unpack(obj):
+    if isinstance(obj, dict):
+        if obj.get("__nd__"):
+            return np.frombuffer(obj["data"], dtype=obj["dtype"]).reshape(obj["shape"]).copy()
+        return {k: _unpack(v) for k, v in obj.items()}
+    if isinstance(obj, list):
+        return [_unpack(v) for v in obj]
+    return obj
+
+
+def _recv_exact(conn: socket.socket, n: int) -> bytes:
+    buf = b""
+    while len(buf) < n:
+        chunk = conn.recv(n - len(buf))
+        if not chunk:
+            raise ConnectionError("peer closed connection")
+        buf += chunk
+    return buf
+
+
+def recv_msg(conn: socket.socket) -> dict:
+    (length,) = struct.unpack(">I", _recv_exact(conn, 4))
+    return _unpack(pickle.loads(_recv_exact(conn, length)))
+
+
+def send_msg(conn: socket.socket, obj: dict) -> None:
+    payload = pickle.dumps(_pack(obj), protocol=pickle.HIGHEST_PROTOCOL)
+    conn.sendall(struct.pack(">I", len(payload)) + payload)
+
+
+def _build_prompt(msg: dict) -> str:
+    prompt = msg.get("prompt")
+    if prompt:
+        return str(prompt)
+    task = str(msg.get("task", ""))
+    phase = msg.get("phase")
+    return f"Task: {task} Phase: {phase}." if phase else task
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", default="pi05_hrc_e4_main", help="openpi train config name")
+    ap.add_argument(
+        "--checkpoint",
+        type=Path,
+        default=Path("/root/autodl-tmp/openpi_hrc/checkpoints/pi05_hrc_e4_main/hrc_e4_seed42/5000"),
+    )
+    ap.add_argument("--host", default="127.0.0.1")
+    ap.add_argument("--port", type=int, default=18765)
+    ap.add_argument("--execute-horizon", type=int, default=8, help="steps executed per 32-step plan")
+    args = ap.parse_args()
+    args.checkpoint = canonical_checkpoint_path(args.checkpoint)
+
+    from openpi.policies.policy_config import create_trained_policy
+    from openpi.training.config import get_config
+
+    print(f"[pi05-server] loading {args.config} @ {args.checkpoint} ...", flush=True)
+    policy = create_trained_policy(get_config(args.config), args.checkpoint)
+    exec_h = validate_execute_horizon(args.execute_horizon)
+    plan_queue: collections.deque = collections.deque()
+    print(f"[pi05-server] ready: config={args.config}, execute_horizon={exec_h}", flush=True)
+
+    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    srv.bind((args.host, args.port))
+    srv.listen(1)
+    print(f"[pi05-server] listening on {args.host}:{args.port}", flush=True)
+
+    n_queries = 0
+    n_infer = 0
+    t_infer = 0.0
+    running = True
+    while running:
+        conn, addr = srv.accept()
+        print(f"[pi05-server] client connected: {addr}", flush=True)
+        try:
+            while True:
+                msg = recv_msg(conn)
+                mtype = msg.get("type")
+                if mtype == "ping":
+                    send_msg(conn, {"ok": True, "msg": "pong", "action_horizon": 32,
+                                    "action_dim": 23, "execute_horizon": exec_h,
+                                    "config": args.config,
+                                    "checkpoint": str(args.checkpoint)})
+                elif mtype == "reset":
+                    plan_queue.clear()
+                    seed = msg.get("seed")
+                    if seed is not None:
+                        import jax
+
+                        # openpi Policy owns the sampling key. Resetting it at an
+                        # episode boundary makes the two Gate-3 policy seeds
+                        # reproducible without rebuilding checkpoint weights.
+                        if not hasattr(policy, "_rng"):
+                            raise RuntimeError("loaded policy does not expose a JAX sampling RNG")
+                        policy._rng = jax.random.key(int(seed))
+                    send_msg(conn, {"ok": True, "seed": seed})
+                elif mtype == "shutdown":
+                    send_msg(conn, {"ok": True})
+                    running = False
+                    break
+                elif mtype == "act":
+                    try:
+                        if not plan_queue:
+                            state, head = validate_act_request(msg)
+                            t0 = time.time()
+                            result = policy.infer(
+                                {
+                                    "observation/image_0": head,
+                                    "observation/state": state,
+                                    "prompt": _build_prompt(msg),
+                                }
+                            )
+                            actions = validate_action_chunk(result["actions"])
+                            for step in actions[:exec_h]:
+                                plan_queue.append(step)
+                            n_infer += 1
+                            t_infer += time.time() - t0
+                        action = plan_queue.popleft()
+                        n_queries += 1
+                        if n_queries % 200 == 0:
+                            avg = 1e3 * t_infer / max(n_infer, 1)
+                            print(f"[pi05-server] {n_queries} acts, {n_infer} infers, "
+                                  f"avg {avg:.1f} ms/infer", flush=True)
+                        send_msg(conn, {"ok": True, "action": action})
+                    except Exception as exc:  # noqa: BLE001
+                        traceback.print_exc()
+                        send_msg(conn, {"ok": False, "error": f"{type(exc).__name__}: {exc}"})
+                else:
+                    send_msg(conn, {"ok": False, "error": f"unknown type {mtype!r}"})
+        except (ConnectionError, EOFError) as exc:
+            print(f"[pi05-server] client gone: {exc}", flush=True)
+        finally:
+            conn.close()
+    srv.close()
+    print(f"[pi05-server] shutdown after {n_queries} acts / {n_infer} infers", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/hrc/serve_hrc_pi05_rollout_test.py b/scripts/hrc/serve_hrc_pi05_rollout_test.py
--- /dev/null
+++ b/scripts/hrc/serve_hrc_pi05_rollout_test.py
@@ -0,0 +1,60 @@
+import numpy as np
+import pytest
+
+from scripts.hrc.serve_hrc_pi05_rollout import validate_action_chunk
+from scripts.hrc.serve_hrc_pi05_rollout import validate_act_request
+from scripts.hrc.serve_hrc_pi05_rollout import validate_execute_horizon
+from scripts.hrc.serve_hrc_pi05_rollout import canonical_checkpoint_path
+
+
+def test_validate_execute_horizon_accepts_required_replanning_protocol():
+    assert validate_execute_horizon(8) == 8
+
+
+def test_validate_execute_horizon_allows_replan_rate_experiments_but_rejects_impossible_ones():
+    # Off-protocol rates are a deliberate experiment knob (warned about, not blocked);
+    # a rate outside [1, action_horizon] is still impossible and must fail.
+    assert validate_execute_horizon(1) == 1
+    assert validate_execute_horizon(32) == 32
+    for bad in (0, -1, 33):
+        with pytest.raises(ValueError, match=r"within \[1, 32\]"):
+            validate_execute_horizon(bad)
+
+
+def test_checkpoint_identity_is_always_absolute(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    assert canonical_checkpoint_path("checkpoints/example/5000") == tmp_path / "checkpoints/example/5000"
+
+
+def test_validate_act_request_normalizes_real_observation():
+    state, head = validate_act_request(
+        {"state": np.zeros(23), "head": np.zeros((224, 224, 3), dtype=np.uint8)}
+    )
+    assert state.shape == (23,)
+    assert state.dtype == np.float32
+    assert head.shape == (224, 224, 3)
+    assert head.dtype == np.uint8
+
+
+@pytest.mark.parametrize(
+    "message",
+    [
+        {"state": np.zeros(22), "head": np.zeros((8, 8, 3), dtype=np.uint8)},
+        {"state": np.full(23, np.nan), "head": np.zeros((8, 8, 3), dtype=np.uint8)},
+        {"state": np.zeros(23), "head": np.zeros((8, 8), dtype=np.uint8)},
+    ],
+)
+def test_validate_act_request_rejects_bad_observation(message):
+    with pytest.raises(ValueError):
+        validate_act_request(message)
+
+
+def test_validate_action_chunk_requires_32_finite_action23_steps():
+    actions = validate_action_chunk(np.zeros((32, 23), dtype=np.float32))
+    assert actions.shape == (32, 23)
+    with pytest.raises(ValueError, match="\[32, 23\]"):
+        validate_action_chunk(np.zeros((8, 23)))
+    bad = np.zeros((32, 23))
+    bad[3, 5] = np.inf
+    with pytest.raises(ValueError, match="finite"):
+        validate_action_chunk(bad)
diff --git a/scripts/hrc/validate_hrc_continuous.py b/scripts/hrc/validate_hrc_continuous.py
--- /dev/null
+++ b/scripts/hrc/validate_hrc_continuous.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python
+"""Validate the exported continuous CLEAN dataset against its source of truth.
+
+Runs the column-level contract checks (:mod:`hrc_continuous_validation`) on each
+split's parquet, then the strong cross-check: rebuild every source's rows from the
+raw HDF5 with :func:`load_continuous_rows` and assert the exported state23 /
+action(shift-1) / context / valid-anchor / fsm / prompt match exactly. Finally an
+aggregate RGB frame-count check. Prints ``VALIDATION=PASS`` only if all pass.
+
+Usage (openpi_hrc/.venv):
+  .venv/bin/python -m scripts.hrc.validate_hrc_continuous \
+      --dataset-root /root/autodl-tmp/lerobot_datasets/hrc_pi05_continuous_clean_v0
+"""
+
+import argparse
+import glob
+import itertools
+import json
+from pathlib import Path
+
+import av
+import numpy as np
+import pyarrow as pa
+import pyarrow.parquet as pq
+
+from openpi.training.hrc_continuous_data import CONTEXT_NAMES
+from openpi.training.hrc_continuous_export import load_continuous_rows
+from openpi.training.hrc_continuous_validation import check_prompt_phase_consistency
+from openpi.training.hrc_continuous_validation import validate_continuous_columns
+
+# Plan §4 (15 CLEAN, source 36 excluded).
+EXPECT = {
+    "train": {"sources": 13, "rows": 130000, "anchors": 128336,
+              "context": {"wait": 169, "pickup": 69987, "follow": 4565, "radio": 53615}},
+    "val": {"sources": 2, "rows": 18507, "anchors": 18251,
+            "context": {"wait": 26, "pickup": 10298, "follow": 1057, "radio": 6870}},
+}
+_META_KEYS = (
+    "hrc.valid_anchor", "hrc.task_id", "hrc.context_id", "hrc.source_episode_id",
+    "hrc.fsm_state_id", "hrc.raw_global_frame_index", "hrc.raw_demo_id",
+    "hrc.raw_demo_frame_index", "episode_index",
+)
+
+
+def read_split_columns(split_root: Path):
+    files = sorted(glob.glob(str(split_root / "data" / "**" / "*.parquet"), recursive=True))
+    if not files:
+        raise FileNotFoundError(f"no parquet under {split_root}/data")
+    table = pa.concat_tables([pq.read_table(f) for f in files])
+    data = table.to_pydict()
+    order = np.argsort(np.asarray(data["index"], dtype=np.int64))  # global row order
+
+    columns = {
+        "observation.state": np.asarray(data["observation.state"], dtype=np.float32)[order],
+        "action": np.asarray(data["action"], dtype=np.float32)[order],
+    }
+    for key in _META_KEYS:
+        dtype = bool if key == "hrc.valid_anchor" else np.int64
+        columns[key] = np.asarray(data[key], dtype=dtype)[order]
+
+    tasks = pq.read_table(split_root / "meta" / "tasks.parquet").to_pydict()
+    index_to_task = {int(i): str(t) for i, t in zip(tasks["task_index"], tasks["task"], strict=True)}
+    prompts = np.array([index_to_task[int(ti)] for ti in np.asarray(data["task_index"])[order]], dtype=object)
+    return columns, prompts
+
+
+def cross_check_sources(columns, prompts, manifest_sources, split_sources, action_horizon, failures):
+    by_id = {int(s["source_episode_id"]): s for s in manifest_sources}
+    for source_id in split_sources:
+        rows = np.flatnonzero(columns["hrc.source_episode_id"] == source_id)
+        # rows for one source are one contiguous episode; order by raw global frame.
+        rows = rows[np.argsort(columns["hrc.raw_global_frame_index"][rows])]
+        rebuilt = load_continuous_rows(by_id[source_id], action_horizon=action_horizon)
+        n = len(rebuilt["action"])
+        if len(rows) != n:
+            failures.append(f"source {source_id}: exported {len(rows)} rows != source {n}")
+            continue
+        checks = {
+            "state23": np.allclose(columns["observation.state"][rows], rebuilt["state"], atol=1e-4, rtol=1e-4),
+            "action_shift1": np.allclose(columns["action"][rows], rebuilt["action"], atol=1e-4, rtol=1e-4),
+            "context_id": np.array_equal(columns["hrc.context_id"][rows], rebuilt["context_id"]),
+            "valid_anchor": np.array_equal(columns["hrc.valid_anchor"][rows], rebuilt["valid_anchor"]),
+            "fsm_state_id": np.array_equal(columns["hrc.fsm_state_id"][rows], rebuilt["fsm_state_id"]),
+            "raw_global_index": np.array_equal(
+                columns["hrc.raw_global_frame_index"][rows], rebuilt["raw_global_frame_index"]
+            ),
+            "prompt": np.array_equal(prompts[rows], rebuilt["prompt"]),
+        }
+        for name, ok in checks.items():
+            if not ok:
+                failures.append(f"source {source_id}: raw cross-check {name} mismatch")
+
+
+def count_video_frames(split_root: Path) -> int:
+    total = 0
+    for video in sorted(glob.glob(str(split_root / "videos" / "**" / "*.mp4"), recursive=True)):
+        with av.open(video) as container:
+            stream = container.streams.video[0]
+            total += stream.frames or sum(1 for _ in container.decode(stream))
+    return total
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", required=True, type=Path)
+    parser.add_argument("--skip-rgb", action="store_true", help="skip the aggregate video frame-count check")
+    parser.add_argument(
+        "--expect",
+        type=Path,
+        default=None,
+        help="frozen per-split expectations JSON (sources/rows/anchors/context) for a dataset "
+        "other than the v0 pilot; splits absent from it must be empty",
+    )
+    args = parser.parse_args()
+
+    expect_all = EXPECT if args.expect is None else json.loads(args.expect.read_text(encoding="utf-8"))
+
+    manifest = json.loads((args.dataset_root / "manifest.json").read_text(encoding="utf-8"))
+    action_horizon = int(manifest["action_horizon"])
+    source_splits = manifest["source_splits"]
+    manifest_sources = manifest["sources"]
+
+    failures: list[str] = []
+    report = {"action_horizon": action_horizon, "splits": {}}
+
+    # cross-split: every declared split is pairwise disjoint; any split without a
+    # frozen expectation must be empty (the v0 pilot declares no test split).
+    declared = [split for split in ("train", "val", "test") if split in expect_all]
+    for left, right in itertools.combinations(declared, 2):
+        overlap = sorted(set(source_splits[left]) & set(source_splits[right]))
+        if overlap:
+            failures.append(f"{left} and {right} sources overlap: {overlap}")
+    for split in ("train", "val", "test"):
+        if split not in expect_all and source_splits.get(split):
+            failures.append(f"{split} split must be empty (no frozen expectation for it)")
+
+    for split in declared:
+        split_sources = sorted(int(s) for s in source_splits[split])
+        split_root = args.dataset_root / split
+        columns, prompts = read_split_columns(split_root)
+
+        try:
+            stats = validate_continuous_columns(
+                columns, expected_sources=set(split_sources), action_horizon=action_horizon
+            )
+            check_prompt_phase_consistency(prompts, columns["hrc.fsm_state_id"])
+        except ValueError as exc:
+            failures.append(f"[{split}] column validation: {exc}")
+            report["splits"][split] = {"error": str(exc)}
+            continue
+
+        cross_check_sources(columns, prompts, manifest_sources, split_sources, action_horizon, failures)
+
+        expect = expect_all[split]
+        if stats["num_sources"] != expect["sources"]:
+            failures.append(f"[{split}] sources {stats['num_sources']} != {expect['sources']}")
+        if stats["num_rows"] != expect["rows"]:
+            failures.append(f"[{split}] rows {stats['num_rows']} != {expect['rows']}")
+        if stats["num_valid_anchors"] != expect["anchors"]:
+            failures.append(f"[{split}] anchors {stats['num_valid_anchors']} != {expect['anchors']}")
+        for name in CONTEXT_NAMES:
+            got = stats["valid_anchors_by_context"][name]
+            if got != expect["context"][name]:
+                failures.append(f"[{split}] context {name} {got} != {expect['context'][name]}")
+
+        rgb_frames = None
+        if not args.skip_rgb:
+            rgb_frames = count_video_frames(split_root)
+            if rgb_frames != stats["num_rows"]:
+                failures.append(f"[{split}] video frames {rgb_frames} != rows {stats['num_rows']}")
+
+        report["splits"][split] = {**stats, "rgb_frames": rgb_frames}
+        print(f"[{split}] rows={stats['num_rows']} anchors={stats['num_valid_anchors']} "
+              f"by_context={stats['valid_anchors_by_context']} rgb_frames={rgb_frames}", flush=True)
+
+    report["failures"] = failures
+    report["result"] = "PASS" if not failures else "FAIL"
+    (args.dataset_root / "validation_report.json").write_text(
+        json.dumps(report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
+    )
+
+    if failures:
+        print("\n".join(f"  ✗ {f}" for f in failures), flush=True)
+        print("VALIDATION=FAIL", flush=True)
+        return 1
+    print("VALIDATION=PASS", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/hrc/validate_hrc_lerobot.py b/scripts/hrc/validate_hrc_lerobot.py
--- /dev/null
+++ b/scripts/hrc/validate_hrc_lerobot.py
@@ -0,0 +1,110 @@
+"""Validate the complete HRC LeRobot export before normalization or training."""
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from openpi.training import hrc_data
+from openpi.training import hrc_export
+from openpi.training import lerobot_compat
+from openpi.training.hrc_validation import validate_exported_split
+
+NUMERIC_KEYS = (
+    "observation.state",
+    "observation.privileged_state",
+    "action",
+    "hrc.valid_anchor",
+    "hrc.task_id",
+    "hrc.source_episode_id",
+    "hrc.raw_frame_index",
+    "episode_index",
+)
+
+
+def _validate_video_samples(dataset, count: int) -> list[int]:
+    if count <= 0:
+        return []
+    indices = np.linspace(0, len(dataset) - 1, num=min(count, len(dataset)), dtype=np.int64)
+    for index in indices:
+        image = np.asarray(dataset[int(index)]["observation.rgb.zed_link_camera_0"])
+        if image.shape != (3, 256, 352):
+            raise ValueError(f"decoded RGB at row {index} has shape {image.shape}, expected [3,256,352]")
+        if not np.isfinite(image).all() or image.min() < 0 or image.max() > 1:
+            raise ValueError(f"decoded RGB at row {index} is not finite in [0,1]")
+    return indices.tolist()
+
+
+def _validate_raw_alignment(dataset, columns: dict[str, np.ndarray], segment: dict) -> dict[str, float | int]:
+    task_id = hrc_data.TASK_NAMES.index(segment["task_name"])
+    matches = np.flatnonzero(
+        (columns["hrc.source_episode_id"] == int(segment["source_episode_id"]))
+        & (columns["hrc.task_id"] == task_id)
+        & (columns["hrc.raw_frame_index"] == int(segment["start_frame"]))
+    )
+    if len(matches) != 1:
+        raise ValueError(f"could not uniquely locate exported first row for segment {segment}")
+    row = int(matches[0])
+
+    raw_rows = hrc_export.load_segment_rows(segment, include_phase=True, action_horizon=32)
+    np.testing.assert_allclose(columns["action"][row], raw_rows["action"][0], rtol=0, atol=0)
+    np.testing.assert_allclose(columns["observation.state"][row], raw_rows["state23"][0], rtol=0, atol=0)
+    np.testing.assert_allclose(
+        columns["observation.privileged_state"][row], raw_rows["state28"][0], rtol=0, atol=0
+    )
+
+    exported = np.asarray(dataset[row]["observation.rgb.zed_link_camera_0"])
+    exported = np.rint(exported.transpose(1, 2, 0) * 255).astype(np.uint8)
+    raw = hrc_export.MonotonicFrameCursor(hrc_export.decode_rgb_frames(segment["head_video_path"])).get(
+        int(segment["start_frame"])
+    )
+    pixel_error = np.abs(exported.astype(np.float32) - raw.astype(np.float32))
+    mae = float(pixel_error.mean())
+    p99 = float(np.quantile(pixel_error, 0.99))
+    if mae > 5.0 or p99 > 20.0:
+        raise ValueError(f"exported RGB/raw video mismatch at row {row}: mae={mae:.3f}, p99={p99:.3f}")
+    return {"row": row, "rgb_mae": mae, "rgb_p99": p99}
+
+
+def main(dataset_root: Path, video_samples_per_split: int = 3) -> None:
+    manifest = json.loads((dataset_root / "manifest.json").read_text())
+    export_report = json.loads((dataset_root / "export_report.json").read_text())
+    source_splits = {
+        split: {int(value) for value in manifest["source_splits"][split]} for split in ("train", "val", "test")
+    }
+    if any(source_splits[left] & source_splits[right] for left, right in (("train", "val"), ("train", "test"), ("val", "test"))):
+        raise ValueError("source leakage between train/val/test manifest splits")
+    if [len(source_splits[name]) for name in ("train", "val", "test")] != [39, 5, 5]:
+        raise ValueError("expected source split sizes 39/5/5")
+
+    report = {"schema_version": manifest["schema_version"], "splits": {}}
+    for split in ("train", "val", "test"):
+        split_root = dataset_root / split
+        repo_id = f"hrc/hrc_pi05_v0_{split}"
+        dataset = lerobot_compat.LeRobotDataset(repo_id=repo_id, root=split_root)
+        table = dataset.hf_dataset.with_format("numpy")
+        columns = {key: np.asarray(table[key]) for key in NUMERIC_KEYS}
+        split_report = validate_exported_split(
+            columns,
+            expected_sources=source_splits[split],
+            action_horizon=int(manifest["action_horizon"]),
+        )
+        expected = export_report["splits"][split]
+        for key in ("num_sources", "num_episodes", "num_rows", "num_valid_anchors"):
+            if split_report[key] != expected[key]:
+                raise ValueError(f"{split} {key} differs from export_report")
+        split_report["video_sample_rows"] = _validate_video_samples(dataset, video_samples_per_split)
+        alignment_segment = next(segment for segment in manifest["segments"] if segment["split"] == split)
+        split_report["raw_alignment"] = _validate_raw_alignment(dataset, columns, alignment_segment)
+        report["splits"][split] = split_report
+
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dataset-root", type=Path, required=True)
+    parser.add_argument("--video-samples-per-split", type=int, default=3)
+    args = parser.parse_args()
+    main(args.dataset_root, video_samples_per_split=args.video_samples_per_split)
diff --git a/scripts/hrc/verify_dissertation_results.py b/scripts/hrc/verify_dissertation_results.py
--- /dev/null
+++ b/scripts/hrc/verify_dissertation_results.py
@@ -0,0 +1,402 @@
+#!/usr/bin/env python
+"""Independently verify frozen dissertation evidence and write a QA report."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+from datetime import UTC
+from datetime import datetime
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from openpi.training import config as training_config
+from openpi.training import hrc_norm_stats
+from scripts.hrc.compute_hrc_norm_stats import DELTA_MAPPINGS
+from scripts.hrc.compute_hrc_norm_stats import _load_numpy_columns
+from scripts.hrc.compute_hrc_norm_stats import _validate_train_only
+from scripts.hrc.dissertation_protocol import ACTION_DIM
+from scripts.hrc.dissertation_protocol import ACTION_GROUPS
+from scripts.hrc.dissertation_protocol import ACTION_HORIZON
+from scripts.hrc.dissertation_protocol import DELTA_DIMS
+from scripts.hrc.dissertation_protocol import GRIPPER_DIMS
+from scripts.hrc.dissertation_protocol import file_sha256
+from scripts.hrc.dissertation_protocol import load_split_rows
+from scripts.hrc.dissertation_protocol import write_json_atomic
+from scripts.hrc.run_dissertation_conditioning_probe import DEFAULT_OUTPUT_ROOT as PROBE_ROOT
+from scripts.hrc.run_dissertation_final_audit import DEFAULT_FLOW_SEEDS
+from scripts.hrc.run_dissertation_final_audit import DEFAULT_OUTPUT_ROOT as AUDIT_ROOT
+from scripts.hrc.run_dissertation_final_audit import MODEL_SPECS
+from scripts.hrc.run_dissertation_final_audit import REPO_ROOT
+from scripts.hrc.run_dissertation_final_audit import SPLIT_MANIFEST
+from scripts.hrc.run_dissertation_target_visibility import DEFAULT_OUTPUT_ROOT as VISIBILITY_ROOT
+
+DEFAULT_OUTPUT = REPO_ROOT / "outputs/dissertation_quality_control/qa_report.json"
+PROTOCOL_SEED = 20260907
+SPOT_CHECK_COUNT = 10
+
+
+def utc_now() -> str:
+    return datetime.now(UTC).isoformat()
+
+
+def _events(sign_rows: np.ndarray, previous_sign: np.ndarray) -> list[tuple[int, int, float]]:
+    earlier = np.vstack((previous_sign[None, :], sign_rows[:-1]))
+    return [
+        (int(frame), int(gripper), float(sign_rows[frame, gripper]))
+        for frame, gripper in np.argwhere(sign_rows != earlier)
+    ]
+
+
+def independent_anchor_score(
+    predicted: np.ndarray,
+    expert: np.ndarray,
+    state: np.ndarray,
+    previous: np.ndarray,
+    *,
+    tolerance: int = 8,
+) -> dict[str, float | int | None]:
+    """Reimplement the paper metrics without calling the production scorer."""
+    predicted = np.asarray(predicted, dtype=np.float64)
+    expert = np.asarray(expert, dtype=np.float64)
+    state = np.asarray(state, dtype=np.float64)
+    previous = np.asarray(previous, dtype=np.float64)
+    if predicted.shape != expert.shape or predicted.ndim != 2 or predicted.shape[1] != ACTION_DIM:
+        raise ValueError("invalid action chunks")
+    null = np.zeros_like(expert)
+    null[:, list(DELTA_DIMS)] = state[list(DELTA_DIMS)]
+    null[:, list(GRIPPER_DIMS)] = previous[list(GRIPPER_DIMS)]
+    result: dict[str, float | int | None] = {}
+    for group, dims in ACTION_GROUPS.items():
+        raw = float(np.mean(np.abs(predicted[:, list(dims)] - expert[:, list(dims)])))
+        null_mae = float(np.mean(np.abs(null[:, list(dims)] - expert[:, list(dims)])))
+        result[f"{group}_raw_mae"] = raw
+        result[f"{group}_null_mae"] = null_mae
+        result[f"{group}_skill"] = 1.0 - raw / null_mae if null_mae > 0 else None
+    model_motion = float(
+        np.mean(np.abs(predicted[:, list(DELTA_DIMS)] - state[list(DELTA_DIMS)]))
+    )
+    expert_motion = float(
+        np.mean(np.abs(expert[:, list(DELTA_DIMS)] - state[list(DELTA_DIMS)]))
+    )
+    result["arm_motion_model"] = model_motion
+    result["arm_motion_expert"] = expert_motion
+    result["arm_motion_ratio"] = model_motion / expert_motion if expert_motion > 0 else None
+
+    previous_sign = np.sign(previous[list(GRIPPER_DIMS)])
+    predicted_events = _events(np.sign(predicted[:, list(GRIPPER_DIMS)]), previous_sign)
+    expert_events = _events(np.sign(expert[:, list(GRIPPER_DIMS)]), previous_sign)
+    unmatched = list(expert_events)
+    true_positives = 0
+    for frame, gripper, direction in predicted_events:
+        for index, (expert_frame, expert_gripper, expert_direction) in enumerate(unmatched):
+            if (
+                gripper == expert_gripper
+                and direction == expert_direction
+                and abs(frame - expert_frame) <= tolerance
+            ):
+                true_positives += 1
+                unmatched.pop(index)
+                break
+    result["gripper_expert_events"] = len(expert_events)
+    result["gripper_predicted_events"] = len(predicted_events)
+    result["gripper_true_positives"] = true_positives
+    result["gripper_precision"] = (
+        true_positives / len(predicted_events) if predicted_events else None
+    )
+    result["gripper_recall"] = true_positives / len(expert_events) if expert_events else None
+    result["gripper_f1"] = (
+        2 * true_positives / (len(predicted_events) + len(expert_events))
+        if expert_events
+        else None
+    )
+    return result
+
+
+def _read_csv(path: Path) -> list[dict[str, str]]:
+    with path.open(newline="", encoding="utf-8") as handle:
+        return list(csv.DictReader(handle))
+
+
+def _compare_value(actual: float | int | None, serialized: str, label: str) -> float:
+    if actual is None:
+        if serialized != "":
+            raise AssertionError(f"{label}: expected empty value, got {serialized!r}")
+        return 0.0
+    if serialized == "":
+        raise AssertionError(f"{label}: unexpectedly empty")
+    difference = abs(float(actual) - float(serialized))
+    scale = max(abs(float(actual)), abs(float(serialized)), 1.0)
+    scaled_difference = difference / scale
+    if difference > 1e-7 and scaled_difference > 1e-6:
+        raise AssertionError(
+            f"{label}: independent difference {difference} (scaled {scaled_difference})"
+        )
+    return scaled_difference
+
+
+def _audit_checks(split: dict[str, Any]) -> dict[str, Any]:
+    manifest_path = AUDIT_ROOT / "anchor_manifest.json"
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    manifest_sha = file_sha256(manifest_path)
+    val_sources = sorted(int(value) for value in split["source_splits"]["val"])
+    anchor_splits = {str(anchor["split"]) for anchor in manifest["anchors"]}
+    if anchor_splits != {"val"} or manifest["source_ids"] != val_sources:
+        raise AssertionError("audit manifest is not bound to the frozen validation sources")
+    if len(manifest["anchors"]) != 652:
+        raise AssertionError("audit manifest does not contain 652 anchors")
+    rng = np.random.default_rng(PROTOCOL_SEED)
+    spot_indices = sorted(
+        int(value) for value in rng.choice(len(manifest["anchors"]), SPOT_CHECK_COUNT, replace=False)
+    )
+    spot_ids = [str(manifest["anchors"][index]["anchor_id"]) for index in spot_indices]
+    model_reports = {}
+    for label, spec in MODEL_SPECS.items():
+        summary = json.loads((AUDIT_ROOT / label / "summary.json").read_text(encoding="utf-8"))
+        if summary["manifest_sha256"] != manifest_sha:
+            raise AssertionError(f"{label} summary manifest mismatch")
+        if summary["flow_seeds"] != list(DEFAULT_FLOW_SEEDS):
+            raise AssertionError(f"{label} flow seeds mismatch")
+        if summary["determinism_max_abs_diff"] != 0.0:
+            raise AssertionError(f"{label} fixed-noise determinism failed")
+        rows = load_split_rows(spec.split_root)
+        max_difference = 0.0
+        seed_reports = {}
+        for seed in DEFAULT_FLOW_SEEDS:
+            seed_root = AUDIT_ROOT / label / "per_seed" / f"seed_{seed}"
+            with np.load(seed_root / "predictions.npz", allow_pickle=False) as archive:
+                predictions = np.asarray(archive["predictions"], dtype=np.float32)
+                anchor_ids = [str(value) for value in archive["anchor_ids"]]
+            expected_ids = [str(anchor["anchor_id"]) for anchor in manifest["anchors"]]
+            if predictions.shape != (652, ACTION_HORIZON, ACTION_DIM):
+                raise AssertionError(f"{label} seed {seed} prediction shape mismatch")
+            if anchor_ids != expected_ids or not np.isfinite(predictions).all():
+                raise AssertionError(f"{label} seed {seed} prediction identity/finite check failed")
+            csv_rows = _read_csv(seed_root / "per_anchor.csv")
+            if [row["anchor_id"] for row in csv_rows] != expected_ids:
+                raise AssertionError(f"{label} seed {seed} CSV anchor order mismatch")
+            if seed == DEFAULT_FLOW_SEEDS[0]:
+                for index in spot_indices:
+                    anchor = manifest["anchors"][index]
+                    row_index = int(anchor[spec.row_field])
+                    source = int(anchor["source_episode_id"])
+                    previous = (
+                        rows.action[row_index - 1]
+                        if row_index > 0 and int(rows.source_id[row_index - 1]) == source
+                        else rows.action[row_index]
+                    )
+                    expert = rows.action[row_index : row_index + ACTION_HORIZON]
+                    independent = independent_anchor_score(
+                        predictions[index], expert, rows.state[row_index], previous
+                    )
+                    for metric, value in independent.items():
+                        max_difference = max(
+                            max_difference,
+                            _compare_value(
+                                value,
+                                csv_rows[index][metric],
+                                f"{label}/{seed}/{anchor['anchor_id']}/{metric}",
+                            ),
+                        )
+            seed_reports[str(seed)] = {
+                "num_predictions": len(predictions),
+                "all_finite": True,
+                "anchor_order_exact": True,
+                "near_zero_null_mae_anchors": {
+                    group: sum(abs(float(row[f"{group}_null_mae"])) < 1e-12 for row in csv_rows)
+                    for group in ACTION_GROUPS
+                },
+            }
+        model_reports[label] = {
+            "determinism_max_abs_diff": 0.0,
+            "manifest_sha256": manifest_sha,
+            "independent_spot_check_max_scaled_difference": max_difference,
+            "independent_spot_check_tolerance": {"absolute": 1e-7, "relative": 1e-6},
+            "seeds": seed_reports,
+        }
+    return {
+        "manifest": str(manifest_path),
+        "manifest_sha256": manifest_sha,
+        "split": "val",
+        "source_ids": val_sources,
+        "num_anchors": len(manifest["anchors"]),
+        "spot_check_anchor_ids": spot_ids,
+        "models": model_reports,
+    }
+
+
+def _recompute_stats(config_name: str) -> tuple[dict[str, Any], set[int], Any]:
+    config = training_config.get_config(config_name)
+    factory = config.data
+    columns = _load_numpy_columns(Path(factory.dataset_root), str(factory.repo_id), factory.state_key)
+    _validate_train_only(factory, columns)
+    sources = {int(value) for value in np.unique(columns["hrc.source_episode_id"])}
+    stats = hrc_norm_stats.compute_hrc_norm_stats_from_arrays(
+        states=columns[factory.state_key],
+        actions=columns["action"],
+        valid_mask=columns["hrc.valid_anchor"],
+        task_ids=columns["hrc.task_id"],
+        action_horizon=config.model.action_horizon,
+        delta_mappings=DELTA_MAPPINGS,
+        task_weights=factory.task_weights,
+    )
+    return stats, sources, factory
+
+
+def _stats_max_difference(
+    computed: dict[str, Any],
+    saved_path: Path,
+    *,
+    check_quantiles: bool,
+) -> float:
+    saved = json.loads(saved_path.read_text(encoding="utf-8"))["norm_stats"]
+    maximum = 0.0
+    for key in ("state", "actions"):
+        for statistic in ("mean", "std", "q01", "q99"):
+            if statistic.startswith("q") and not check_quantiles:
+                continue
+            computed_value = getattr(computed[key], statistic)
+            saved_value = saved[key][statistic]
+            if computed_value is None or saved_value is None:
+                if computed_value is not None or saved_value is not None:
+                    raise AssertionError(f"normalization {key}.{statistic} presence mismatch")
+                continue
+            maximum = max(
+                maximum,
+                float(np.max(np.abs(np.asarray(computed_value) - np.asarray(saved_value)))),
+            )
+    if maximum > 1e-10:
+        raise AssertionError(f"normalization stats differ by {maximum}")
+    return maximum
+
+
+def _normalization_checks(split: dict[str, Any]) -> dict[str, Any]:
+    expected_train = {int(value) for value in split["source_splits"]["train"]}
+    a_stats, a_sources, a_factory = _recompute_stats(MODEL_SPECS["A20"].config_name)
+    bc_stats, bc_sources, bc_factory = _recompute_stats(MODEL_SPECS["C20"].config_name)
+    if a_sources != expected_train or bc_sources != expected_train:
+        raise AssertionError("normalization arrays do not exactly contain the frozen train sources")
+    assets = {
+        "A20": Path(a_factory.assets.assets_dir) / str(a_factory.assets.asset_id) / "norm_stats.json",
+        "B20": Path(bc_factory.assets.assets_dir) / "subinstr_rerun_v1/norm_stats.json",
+        "C20": Path(bc_factory.assets.assets_dir) / str(bc_factory.assets.asset_id) / "norm_stats.json",
+    }
+    differences = {
+        "A20": _stats_max_difference(a_stats, assets["A20"], check_quantiles=False),
+        "B20": _stats_max_difference(bc_stats, assets["B20"], check_quantiles=False),
+        "C20": _stats_max_difference(bc_stats, assets["C20"], check_quantiles=True),
+    }
+    hashes = {}
+    for label, spec in MODEL_SPECS.items():
+        checkpoint_assets = list((spec.checkpoint / "assets").glob("*/norm_stats.json"))
+        if len(checkpoint_assets) != 1:
+            raise AssertionError(f"{label} checkpoint has {len(checkpoint_assets)} norm assets")
+        if file_sha256(checkpoint_assets[0]) != file_sha256(assets[label]):
+            raise AssertionError(f"{label} checkpoint and repository norm stats differ")
+        hashes[label] = {
+            "repository_asset": str(assets[label]),
+            "checkpoint_asset": str(checkpoint_assets[0]),
+            "sha256": file_sha256(assets[label]),
+            "recomputed_max_abs_diff": differences[label],
+        }
+    return {
+        "train_source_ids": sorted(expected_train),
+        "val_test_source_overlap": [],
+        "assets": hashes,
+    }
+
+
+def _conditioning_checks(split: dict[str, Any]) -> dict[str, Any]:
+    manifest_path = PROBE_ROOT / "anchor_manifest.json"
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    test_sources = {int(value) for value in split["source_splits"]["test"]}
+    observed_sources = {int(anchor["source_episode_id"]) for anchor in manifest["anchors"]}
+    if observed_sources & test_sources:
+        raise AssertionError("conditioning manifest contains test sources")
+    if len(manifest["anchors"]) != 324:
+        raise AssertionError("conditioning manifest does not contain 324 anchors")
+    reports = {}
+    for label in ("B20", "C20"):
+        summary = json.loads((PROBE_ROOT / label / "summary.json").read_text(encoding="utf-8"))
+        rows = _read_csv(PROBE_ROOT / label / "per_anchor.csv")
+        ratio_fields = [field for field in rows[0] if field.endswith("_over_noise")]
+        nonfinite = sum(
+            not np.isfinite(float(row[field])) for row in rows for field in ratio_fields
+        )
+        if summary["determinism_max_abs_diff"] != 0.0 or len(rows) != 324 or nonfinite:
+            raise AssertionError(f"{label} conditioning completeness/finite check failed")
+        reports[label] = {
+            "num_anchors": len(rows),
+            "num_inferences": summary["num_inferences"],
+            "determinism_max_abs_diff": summary["determinism_max_abs_diff"],
+            "nonfinite_ratios": nonfinite,
+        }
+    return {
+        "manifest": str(manifest_path),
+        "source_ids": sorted(observed_sources),
+        "test_source_overlap": [],
+        "num_anchors": len(manifest["anchors"]),
+        "models": reports,
+    }
+
+
+def _visibility_checks() -> dict[str, Any]:
+    summary = json.loads((VISIBILITY_ROOT / "summary.json").read_text(encoding="utf-8"))
+    if summary["missing_files"] or summary["num_sources"] != 45:
+        raise AssertionError("visibility population is incomplete")
+    frame_count = sum(1 for _ in (VISIBILITY_ROOT / "per_frame.csv").open(encoding="utf-8")) - 1
+    anchor_count = sum(1 for _ in (VISIBILITY_ROOT / "per_anchor.csv").open(encoding="utf-8")) - 1
+    if frame_count != summary["num_relevant_frames"]:
+        raise AssertionError("visibility per-frame row count mismatch")
+    if anchor_count != summary["num_valid_relevant_anchors"]:
+        raise AssertionError("visibility per-anchor row count mismatch")
+    return {
+        "num_sources": summary["num_sources"],
+        "num_relevant_frames": frame_count,
+        "num_valid_relevant_anchors": anchor_count,
+        "missing_files": summary["missing_files"],
+        "occlusion_considered": summary["visibility_definition"]["occlusion_considered"],
+    }
+
+
+def run(output: Path) -> None:
+    output = output.resolve()
+    if output.exists():
+        raise FileExistsError(f"refusing to overwrite {output}")
+    split = json.loads(SPLIT_MANIFEST.read_text(encoding="utf-8"))
+    source_sets = {
+        name: {int(value) for value in values}
+        for name, values in split["source_splits"].items()
+    }
+    if any(source_sets[left] & source_sets[right] for left, right in (("train", "val"), ("train", "test"), ("val", "test"))):
+        raise AssertionError("frozen source splits overlap")
+    report = {
+        "schema_version": 1,
+        "status": "passed",
+        "completed_at_utc": utc_now(),
+        "protocol_seed": PROTOCOL_SEED,
+        "split_manifest": str(SPLIT_MANIFEST),
+        "split_manifest_sha256": file_sha256(SPLIT_MANIFEST),
+        "source_split_counts": {key: len(value) for key, value in source_sets.items()},
+        "audit": _audit_checks(split),
+        "normalization": _normalization_checks(split),
+        "conditioning": _conditioning_checks(split),
+        "visibility": _visibility_checks(),
+    }
+    write_json_atomic(output, report)
+    print(f"[qa] all checks passed; wrote {output}", flush=True)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    args = parser.parse_args()
+    run(args.output)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
