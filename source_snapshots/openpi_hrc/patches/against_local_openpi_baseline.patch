+
+def test_load_segment_rows_matches_raw_shifted_action():
+    data_root = Path("/root/autodl-tmp/hrc_pipeline_traintest/outputs/hrc_batch_final")
+    manifest = hrc_data.build_manifest(data_root, seed=42, action_horizon=32)
